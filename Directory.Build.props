<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Язык, на котором написаны сами ресурсы: их строки лежат в основной
         сборке, и за русским текстом ходить в сателлит не нужно. Появится
         перевод — он и станет сателлитом, а этот останется запасным.

         InvariantGlobalization включать нельзя никогда: на нём умирают
         и «25 августа», и разбор часовых поясов, а сборка об этом молчит. -->
    <NeutralLanguage>ru</NeutralLanguage>

    <!-- Предупреждение, замеченное поздно, стоит дороже сломанной сборки -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Файл документации нужен всем проектам: без него сборка не выдаёт ни CS1591,
       ни лишних using (IDE0005 в .editorconfig), и оба проходят молча. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Публичные члены без комментария роняют сборку только в библиотеках. Тестов
       и страниц MAUI правило не касается — там публичность техническая. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Finance.Domain' And '$(MSBuildProjectName)' != 'Finance.Application' And '$(MSBuildProjectName)' != 'Finance.Import'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
