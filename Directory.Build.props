<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Язык, на котором написаны сами ресурсы: их строки лежат в основной
         сборке, и за русским текстом ходить в сателлит не нужно. Появится
         перевод — он и станет сателлитом, а этот останется запасным.

         InvariantGlobalization включать нельзя никогда: на нём умирают
         и «25 августа», и разбор часовых поясов, а сборка об этом молчит. -->
    <NeutralLanguage>ru</NeutralLanguage>

    <!-- Предупреждение, замеченное поздно, стоит дороже сломанной сборки -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Публичные члены обязаны быть прокомментированы: без файла документации
       CS1591 не выдаётся, и забытый комментарий проходит молча. Тестов и
       страниц MAUI правило не касается — там публичность техническая. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Finance.Domain' Or '$(MSBuildProjectName)' == 'Finance.Application' Or '$(MSBuildProjectName)' == 'Finance.Import'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
