{
  "stryker-config": {
    "test-projects": [
      "../../tests/Finance.Application.Tests/Finance.Application.Tests.csproj"
    ],
    "mutate": [
      "!**/Migrations/**/*.cs",
      "!**/DesignTimeFinanceDbContextFactory.cs",
      "!**/Faults.cs",
      "!**/*Configuration.cs",
