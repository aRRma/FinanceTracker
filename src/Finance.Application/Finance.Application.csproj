<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Nullable, ImplicitUsings и режим предупреждений — в Directory.Build.props -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Finance.Domain\Finance.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />

    <!-- Только для `dotnet ef`: в приложение уезжать этому пакету незачем -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <!-- Строки таблиц внутренние: наружу они не нужны, а тестам нужны -->
  <ItemGroup>
    <InternalsVisibleTo Include="Finance.Application.Tests" />
  </ItemGroup>

  <!-- Класс доступа к текстам собирается из .resx самой сборкой: PublicClass —
       чтобы разметка в Finance.App читала его через {x:Static}, а сгенерированный
       файл кладётся в obj, иначе он попал бы под проверки исходников -->
  <ItemGroup>
    <EmbeddedResource Update="Texts\UiTexts.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Finance.Application.Texts</StronglyTypedNamespace>
      <StronglyTypedClassName>UiTexts</StronglyTypedClassName>
      <StronglyTypedManifestPrefix>Finance.Application.Texts</StronglyTypedManifestPrefix>
      <StronglyTypedFileName>$(IntermediateOutputPath)UiTexts.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Стартовый набор и значки едут внутри сборки: инициализация базы идёт
       без обращения к сети и без файлов рядом с приложением (SEED-01, NFR-21) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\preset.json" LogicalName="Finance.Application.preset.json" />
    <EmbeddedResource Include="..\..\data\icons.json" LogicalName="Finance.Application.icons.json" />
  </ItemGroup>

</Project>
