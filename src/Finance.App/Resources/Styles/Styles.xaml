<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Оформление по ролям, а не по цветам. Страница выбирает стиль по смыслу —
    «вторичная подпись», «сумма дохода», «карточка», — и обе темы получаются
    из одного описания. Значения цветов лежат в Colors.xaml и только там.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:controls="clr-namespace:Finance.App.Controls">

    <!-- Зона касания: меньше 48 dp попасть пальцем не получается -->
    <x:Double x:Key="TouchTarget">48</x:Double>

    <!-- Сколько места оставить под плавающей кнопкой: её сторона плюс поля с двух
         сторон. Считается отсюда, а не подбирается на каждом списке заново -->
    <x:Double x:Key="FloatingButtonClearance">96</x:Double>

    <!-- Значок рядом с текстом: тем же тоном, что вторичная подпись -->
    <Style TargetType="controls:Icon">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Выбранный значок: цветом действия, чтобы отличался в сетке выбора -->
    <Style x:Key="AccentIcon" TargetType="controls:Icon">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--
        Знак навигации и запрета: шеврон, замок, ручка перетаскивания. Тише
        значка строки намеренно — он подсказка, а не содержание строки.
    -->
    <Style x:Key="MutedIcon" TargetType="controls:Icon">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Знак необратимого: предупреждение перед заменой данных -->
    <Style x:Key="NegativeIcon" TargetType="controls:Icon">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PaperLight}, Dark={StaticResource PaperDark}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TitleColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Shell.TabBarForegroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TabBarTitleColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
    </Style>

    <!-- Основной текст -->
    <Style TargetType="Label" ApplyToDerivedTypes="True">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Вторичная подпись: место, счёт, пояснение под полем -->
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Подпись поля и прочий третичный текст -->
    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Заголовок раздела -->
    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Крупная сумма: «доступно к тратам», итог отчёта. Только числам: заголовок,
         набранный этим кеглем, кричит громче главной цифры экрана -->
    <Style x:Key="TotalLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!-- Сумма в строке списка. Свой стиль, чтобы шрифт и кегль сумм менялись
         в одном месте; цветные варианты ниже наследуют его -->
    <Style x:Key="AmountLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Сумма смысловым цветом. Отдельные стили на основе AmountLabel, а не общий
         стиль цвета: триггер меняет стиль целиком и потерял бы кегль и шрифт суммы -->
    <Style x:Key="AmountPositiveLabel" TargetType="Label" BasedOn="{StaticResource AmountLabel}">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
    </Style>

    <Style x:Key="AmountNegativeLabel" TargetType="Label" BasedOn="{StaticResource AmountLabel}">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
    </Style>

    <!-- Итог дня в шапке ленты: тот же тон, что заголовок раздела -->
    <Style x:Key="AmountSectionLabel" TargetType="Label" BasedOn="{StaticResource AmountLabel}">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Главная цифра формы операции: вычисленный итог по центру, в одну строку.
         Кегль 40 — верхний предел: длинную сумму FitLabel ужимает по ширине. Высота
         закреплена: подсказка вместо итога мельче, и без неё карточка прыгала бы -->
    <Style x:Key="AmountHero" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- Подсказка на месте итога, пока в сумме незакрыто действие: той же высоты,
         что итог, чтобы карточка не прыгала -->
    <Style x:Key="AmountPending" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
    </Style>

    <!-- Набранное выражение над итогом — только когда в нём есть знак действия -->
    <Style x:Key="AmountExpression" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="HeadTruncation" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
    </Style>

    <!-- Значок поля под суммой: счёт или подкатегория на круглой плашке -->
    <Style x:Key="FieldBadge" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--
        Точка у подписи незаполненного обязательного поля под суммой. Видна только
        вместе с кольцом у значка: поле ждёт выбора. Рамка вокруг поля и залитый
        значок отвергнуты — категория пуста на каждой новой операции, и громкая
        подсветка встречала бы пользователя каждый раз.
    -->
    <Style x:Key="RequiredDot" TargetType="BoxView">
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="WidthRequest" Value="6" />
        <Setter Property="HeightRequest" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Подпись и значение поля под суммой -->
    <Style x:Key="FieldValue" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- Заголовок пустого состояния и название экрана внутри страницы -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Отрицательный баланс: различим в обеих темах -->
    <Style x:Key="NegativeLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
    </Style>

    <!-- Карточка: список счетов, лента, форма -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Карточка нарушенного правила: своим фоном, а не обычной карточкой с красным
         текстом. Красный текст на белом читается как подпись, а не как ошибка -->
    <Style x:Key="ErrorCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource NegativeBackgroundLight}, Dark={StaticResource NegativeBackgroundDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
    </Style>

    <!-- Разделитель строк внутри карточки -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
    </Style>

    <!--
        Плашка-счётчик: число операций у места, число подкатегорий у группы.
        Отдельным фоном, а не серым текстом: число рядом с суммой того же
        размера читается как ещё одна сумма.
    -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Кнопка действия. Недоступная гаснет прозрачностью: IsEnabled сам кнопку
         не гасит, и залитая цветом действия она обещала бы нажатие, которого не будет.
         Прозрачностью, а не своим цветом — погашенная пара «текст на фоне» не попадает
         в палитру и в ContrastTests -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.35" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}" />

    <!-- Плавающая кнопка добавления операции: правый нижний угол, поверх списка.
         Знак «+» подписью, а не картинкой: подпись перекрашивается вместе с темой,
         а растр пришлось бы держать в двух вариантах и переключать привязкой.
         Тень отделяет кнопку от списка под ней: без неё она читается как наклейка -->
    <Style x:Key="FloatingButton" TargetType="Button">
        <!-- В тёмной теме кнопка цветом карточки с акцентной обводкой: залитая акцентом
             она была бы самым ярким предметом экрана, ярче любой суммы -->
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="BorderWidth" Value="{AppThemeBinding Light=0, Dark=1}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource PaperDark}}"
                        Offset="0,3" Radius="8" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Та же кнопка с подписью: там, где рядом есть другой «плюс» -->
    <Style x:Key="ExtendedFloatingButton" TargetType="Button" BasedOn="{StaticResource FloatingButton}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="WidthRequest" Value="-1" />
        <Setter Property="Padding" Value="20,0,22,0" />
    </Style>

    <!-- Кнопка сохранения формы. Пока запись идёт, подпись говорит об этом:
         погашенная кнопка без объяснения читается как поломка, а не как ожидание -->
    <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Style.Triggers>
            <DataTrigger TargetType="Button" Binding="{Binding IsSaving}" Value="True">
                <Setter Property="Text" Value="{x:Static texts:UiTexts.CommonSaving}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Сохранение на панели заголовка. Своя разметка панели, а не ToolbarItem:
        тот рисуется подписью системного вида, а зелёной клавише у правого края
        нужен свой фон. Заголовок при этом тоже свой — штатный Shell.Title
        вместе со своим содержимым панели не показывается.
    -->
    <Style x:Key="BarTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="BarSaveButton" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <!-- Пока сохранять нечего, клавиша гаснет: залитая цветом действия, она
             обещает нажатие, которого не будет. Прозрачностью, а не своим цветом —
             погашенная пара «текст на фоне» не попадает в палитру и в ContrastTests -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.35" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Удаление на той же панели — подписью: необратимое действие не должно
         выглядеть равным сохранению, а красная клавиша рядом с зелёной спорила
         бы с ней за нажатие -->
    <Style x:Key="BarDangerButton" TargetType="Button" BasedOn="{StaticResource BarSaveButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- Второстепенное действие: «Отмена», «Прервать» -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
    </Style>

    <!-- Необратимое действие: удаление -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
    </Style>

    <!-- Клавиша суммы. Фон карточки, разделители — просветы сетки цветом линии -->
    <Style x:Key="KeypadKey" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CornerRadius" Value="0" />
        <!-- Высоту задаёт своя сетка блока, а не клавиша: цифр четыре ряда,
             действий пять, и рядом они обязаны сойтись по общей высоте.
             Снизу её держит `TouchTarget` из общего стиля кнопки -->
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Клавиша ПИН-кода: круг 72 dp на фоне страницы, как у набора кода телефона.
         Тонкий ободок цветом линии отделяет круг от фона в обеих темах; нажатая
         клавиша заливается цветом действия — палец видит, что цифра принята,
         раньше, чем закрасится точка -->
    <Style x:Key="PinKey" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="BorderColor"
                Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="WidthRequest" Value="72" />
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="CornerRadius" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                            <Setter Property="BorderColor"
                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Знак действия: тот же размер клавиши, тон вторичной подписи -->
    <Style x:Key="KeypadOperator" TargetType="Button" BasedOn="{StaticResource KeypadKey}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!-- Чип быстрого выбора даты: «Сегодня», «Вчера». Выбранный — на фоне действия -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MinimumHeightRequest" Value="32" />
    </Style>

    <Style x:Key="ChipSelected" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <Style x:Key="ChipLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
    </Style>

    <Style x:Key="ChipSelectedLabel" TargetType="Label" BasedOn="{StaticResource ChipLabel}">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Круглая кнопка со значком: стрелки месяца в отчёте. 40 dp — символ
         тонкой гарнитурой пальцем не поймать, а погашенный не разглядеть -->
    <Style x:Key="IconButton" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Клавиша со значком вместо подписи: стирание -->
    <Style x:Key="KeypadCell" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="TitleColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="CancelButtonColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
    </Style>

    <!--
        Вид операции и вид категории выбираются сегментами во всю ширину, как в
        макетах. Встроенный шаблон MAUI рисует кружок на плашке со своим фоном,
        мимо токенов темы: она остаётся белой и в тёмной теме. Шаблон общий —
        радиокнопок другого вида в приложении нет.
    -->
    <ControlTemplate x:Key="SegmentTemplate">
        <Border x:Name="Plate" BackgroundColor="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 8" Padding="0,8"
                MinimumHeightRequest="{StaticResource TouchTarget}">
            <Label x:Name="Caption" Text="{TemplateBinding Content}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
                                <!-- В тёмной теме подпись основным текстом, а не цветом
                                     действия: акцент на своём фоне стоит у самого порога
                                     4,5 (ContrastTests). Выбранный сегмент
                                     и так виден плашкой -->
                                <Setter TargetName="Caption" Property="Label.TextColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource InkDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <Style TargetType="RadioButton">
        <Setter Property="ControlTemplate" Value="{StaticResource SegmentTemplate}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!--
        Вид операции подписан своим цветом и своим знаком: три одинаково серых
        слова читаются как подпись, а не как выбор, и расход от дохода глазом
        не отличить. Шаблонов три, а не один с параметрами: цвет плашки живёт
        в сеттере состояния, а тот принимает только готовое значение.
        Сегменты стоят в одной плитке и читаются одним переключателем, а не тремя
        кнопками: без полей, во всю её высоту, углы срезает сама плитка. Выбранный
        залит своим цветом с жирной подписью кнопки действия: бледная плашка того же
        тона сливалась с соседними, и выбор с первого взгляда не читался.
    -->
    <Style x:Key="SegmentBar" TargetType="Border" BasedOn="{StaticResource Card}" />

    <ControlTemplate x:Key="ExpenseSegmentTemplate">
        <Border x:Name="Plate" StrokeThickness="0"
                StrokeShape="Rectangle" Padding="0"
                MinimumHeightRequest="{StaticResource TouchTarget}"
                BackgroundColor="Transparent">
            <Grid HorizontalOptions="Center" ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="4,0">
                <controls:Icon x:Name="Glyph" Key="arrow-down-left"
                               Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                <controls:FitLabel x:Name="Caption" Grid.Column="1" MinimumSize="11" Text="{TemplateBinding Content}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                <Setter TargetName="Glyph" Property="Shape.Stroke"
                                        Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                <Setter TargetName="Caption" Property="Label.TextColor"
                                        Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                <Setter TargetName="Caption" Property="Label.FontFamily" Value="OpenSansSemibold" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="IncomeSegmentTemplate">
        <Border x:Name="Plate" StrokeThickness="0"
                StrokeShape="Rectangle" Padding="0"
                MinimumHeightRequest="{StaticResource TouchTarget}"
                BackgroundColor="Transparent">
            <Grid HorizontalOptions="Center" ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="4,0">
                <controls:Icon x:Name="Glyph" Key="arrow-up-right"
                               Stroke="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                <controls:FitLabel x:Name="Caption" Grid.Column="1" MinimumSize="11" Text="{TemplateBinding Content}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                <Setter TargetName="Glyph" Property="Shape.Stroke"
                                        Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                <Setter TargetName="Caption" Property="Label.TextColor"
                                        Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                <Setter TargetName="Caption" Property="Label.FontFamily" Value="OpenSansSemibold" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="TransferSegmentTemplate">
        <Border x:Name="Plate" StrokeThickness="0"
                StrokeShape="Rectangle" Padding="0"
                MinimumHeightRequest="{StaticResource TouchTarget}"
                BackgroundColor="Transparent">
            <Grid HorizontalOptions="Center" ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="4,0">
                <controls:Icon x:Name="Glyph" Key="swap"
                               Stroke="{AppThemeBinding Light={StaticResource TransferLight}, Dark={StaticResource TransferDark}}" />
                <controls:FitLabel x:Name="Caption" Grid.Column="1" MinimumSize="11" Text="{TemplateBinding Content}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TransferLight}, Dark={StaticResource TransferDark}}" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource TransferLight}, Dark={StaticResource TransferDark}}" />
                                <Setter TargetName="Glyph" Property="Shape.Stroke"
                                        Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                <Setter TargetName="Caption" Property="Label.TextColor"
                                        Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
                                <Setter TargetName="Caption" Property="Label.FontFamily" Value="OpenSansSemibold" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <Style TargetType="Switch">
        <Setter Property="OnColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="ThumbColor"
                Value="{AppThemeBinding Light={StaticResource KnobLight}, Dark={StaticResource KnobDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

</ResourceDictionary>
