<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Оформление по ролям, а не по цветам. Страница выбирает стиль по смыслу —
    «вторичная подпись», «сумма дохода», «карточка», — и обе темы получаются
    из одного описания. Значения цветов лежат в Colors.xaml и только там.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Finance.App.Controls">

    <!-- Зона касания: меньше 48 dp попасть пальцем не получается (NFR-25) -->
    <x:Double x:Key="TouchTarget">48</x:Double>

    <!-- Сколько места оставить под плавающей кнопкой: её сторона плюс поля с двух
         сторон. Считается отсюда, а не подбирается на каждом списке заново -->
    <x:Double x:Key="FloatingButtonClearance">96</x:Double>

    <!-- Значок рядом с текстом: тем же тоном, что вторичная подпись -->
    <Style TargetType="controls:Icon">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Выбранный значок: цветом действия, чтобы отличался в сетке выбора -->
    <Style x:Key="AccentIcon" TargetType="controls:Icon">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--
        Знак навигации и запрета: шеврон, замок, ручка перетаскивания. Тише
        значка строки намеренно — он подсказка, а не содержание строки.
    -->
    <Style x:Key="MutedIcon" TargetType="controls:Icon">
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PaperLight}, Dark={StaticResource PaperDark}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Shell.ForegroundColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TitleColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="Shell.TabBarBackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Shell.TabBarForegroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TabBarTitleColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
    </Style>

    <!-- Основной текст -->
    <Style TargetType="Label" ApplyToDerivedTypes="True">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Вторичная подпись: место, счёт, пояснение под полем -->
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Подпись поля и прочий третичный текст -->
    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Заголовок раздела -->
    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Крупная сумма: «доступно к тратам», итог отчёта. Только числам: заголовок,
         набранный этим кеглем, кричит громче главной цифры экрана -->
    <Style x:Key="TotalLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!-- Заголовок пустого состояния и название экрана внутри страницы -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Доход и отрицательный баланс: различимы в обеих темах (NFR-25) -->
    <Style x:Key="PositiveLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
    </Style>

    <Style x:Key="NegativeLabel" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
    </Style>

    <!-- Карточка: список счетов, лента, форма -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Карточка нарушенного правила: своим фоном, а не обычной карточкой с красным
         текстом. Красный текст на белом читается как подпись, а не как ошибка -->
    <Style x:Key="ErrorCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource NegativeBackgroundLight}, Dark={StaticResource NegativeBackgroundDark}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
    </Style>

    <!-- Разделитель строк внутри карточки -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
    </Style>

    <!--
        Плашка-счётчик: число операций у места, число подкатегорий у группы.
        Отдельным фоном, а не серым текстом: число рядом с суммой того же
        размера читается как ещё одна сумма.
    -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <!-- Плавающая кнопка добавления операции: правый нижний угол, поверх списка.
         Знак «+» подписью, а не картинкой: подпись перекрашивается вместе с темой,
         а растр пришлось бы держать в двух вариантах и переключать привязкой.
         Тень отделяет кнопку от списка под ней: без неё она читается как наклейка -->
    <Style x:Key="FloatingButton" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="20" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource PaperDark}}"
                        Offset="0,3" Radius="8" Opacity="0.28" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка сохранения формы. Пока запись идёт, подпись говорит об этом:
         погашенная кнопка без объяснения читается как поломка, а не как ожидание -->
    <Style x:Key="SaveButton" TargetType="Button">
        <Style.Triggers>
            <DataTrigger TargetType="Button" Binding="{Binding IsSaving}" Value="True">
                <Setter Property="Text" Value="Сохраняю…" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Второстепенное действие: «Отмена», «Прервать» -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
    </Style>

    <!-- Необратимое действие: удаление -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
    </Style>

    <!-- Клавиша суммы. Фон карточки, разделители — просветы сетки цветом линии -->
    <Style x:Key="KeypadKey" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Знак действия: тот же размер клавиши, тон вторичной подписи -->
    <Style x:Key="KeypadOperator" TargetType="Button" BasedOn="{StaticResource KeypadKey}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
    </Style>

    <!-- Клавиша со значком вместо подписи: стирание -->
    <Style x:Key="KeypadCell" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Сохранение прямо на клавиатуре: рука уже здесь -->
    <Style x:Key="KeypadGo" TargetType="Button">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HeightRequest" Value="54" />
    </Style>

    <!-- Поле суммы: набранное выражение, под ним итог. Набираемое сейчас
         обводится цветом действия — обводку ставит триггер на самой странице -->
    <Style x:Key="AmountField" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="TitleColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTarget}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
        <Setter Property="CancelButtonColor"
                Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
    </Style>

    <!--
        Вид операции и вид категории выбираются сегментами во всю ширину, как в
        макетах. Встроенный шаблон MAUI рисует кружок на плашке со своим фоном,
        мимо токенов темы: она остаётся белой и в тёмной теме. Шаблон общий —
        радиокнопок другого вида в приложении нет.
    -->
    <ControlTemplate x:Key="SegmentTemplate">
        <Border x:Name="Plate" BackgroundColor="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 8" Padding="0,8"
                MinimumHeightRequest="{StaticResource TouchTarget}">
            <Label x:Name="Caption" Text="{TemplateBinding Content}"
                   HorizontalTextAlignment="Center" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
                                <!-- В тёмной теме подпись основным текстом, а не цветом
                                     действия: акцент на своём фоне даёт контраст 3,9
                                     при пороге 4,5 (ContrastTests). Выбранный сегмент
                                     и так виден плашкой -->
                                <Setter TargetName="Caption" Property="Label.TextColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource InkDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <Style TargetType="RadioButton">
        <Setter Property="ControlTemplate" Value="{StaticResource SegmentTemplate}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <!--
        Вид операции подписан своим цветом и своим знаком: три одинаково серых
        слова читаются как подпись, а не как выбор, и расход от дохода глазом
        не отличить. Шаблонов три, а не один с параметрами: цвет плашки живёт
        в сеттере состояния, а тот принимает только готовое значение.
    -->
    <ControlTemplate x:Key="ExpenseSegmentTemplate">
        <Border x:Name="Plate" BackgroundColor="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 8" Padding="0,8"
                MinimumHeightRequest="{StaticResource TouchTarget}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <controls:Icon Key="arrow-down-left"
                               Stroke="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                <Label x:Name="Caption" Text="{TemplateBinding Content}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
            </HorizontalStackLayout>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource NegativeBackgroundLight}, Dark={StaticResource NegativeBackgroundDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="IncomeSegmentTemplate">
        <Border x:Name="Plate" BackgroundColor="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 8" Padding="0,8"
                MinimumHeightRequest="{StaticResource TouchTarget}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <controls:Icon Key="arrow-up-right"
                               Stroke="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                <Label x:Name="Caption" Text="{TemplateBinding Content}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
            </HorizontalStackLayout>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource PositiveBackgroundLight}, Dark={StaticResource PositiveBackgroundDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="TransferSegmentTemplate">
        <Border x:Name="Plate" BackgroundColor="Transparent" StrokeThickness="0"
                StrokeShape="RoundRectangle 8" Padding="0,8"
                MinimumHeightRequest="{StaticResource TouchTarget}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <controls:Icon Key="swap"
                               Stroke="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                <Label x:Name="Caption" Text="{TemplateBinding Content}" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
            </HorizontalStackLayout>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter TargetName="Plate" Property="Border.BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
                                <Setter TargetName="Caption" Property="Label.TextColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource InkDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <Style TargetType="Switch">
        <Setter Property="OnColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="ThumbColor"
                Value="{AppThemeBinding Light={StaticResource KnobLight}, Dark={StaticResource KnobDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor"
                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

</ResourceDictionary>
