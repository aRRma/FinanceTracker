<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Палитра тем. Эталон — переключатель темы в docs/ui/mockups.html: значения
    здесь обязаны совпадать с ним, иначе макет и приложение разойдутся, и сверить
    их будет не с чем.

    Прямые значения цвета живут только в этом файле. В разметке экранов их быть
    не должно: забытый там hex не переключается вместе с темой и находится
    потом глазами по всем страницам.

    Контраст текста к фону сверяет ContrastTests: новый токен текста
    добавляется и в таблицу пар того теста. Палитра приложения —
    подмножество палитры макетов: то, что нужно только рамке телефона
    и модальным окнам макета, здесь не повторяется.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Фон страницы -->
    <Color x:Key="PaperLight">#EDEFF1</Color>
    <Color x:Key="PaperDark">#101315</Color>

    <!-- Фон карточек, списков и нижней навигации -->
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1C2124</Color>

    <!-- Утопленные блоки: шапка даты, поле суммы, клавиши -->
    <Color x:Key="SunkLight">#F4F6F7</Color>
    <Color x:Key="SunkDark">#252B2F</Color>

    <!-- Текст: основной, вторичный, третичный -->
    <Color x:Key="InkLight">#16191C</Color>
    <Color x:Key="InkDark">#E7EAEC</Color>
    <Color x:Key="Ink2Light">#4C535A</Color>
    <Color x:Key="Ink2Dark">#A8AFB5</Color>
    <Color x:Key="Ink3Light">#676D74</Color>
    <Color x:Key="Ink3Dark">#8A9299</Color>

    <!-- Разделитель строк и граница карточки -->
    <Color x:Key="LineLight">#E3E6E9</Color>
    <Color x:Key="LineDark">#2F373C</Color>

    <!-- Акцент и его фон -->
    <Color x:Key="AccentLight">#0F5C4C</Color>
    <Color x:Key="AccentDark">#48A78E</Color>
    <Color x:Key="AccentBackgroundLight">#E2EFEB</Color>
    <Color x:Key="AccentBackgroundDark">#1B342D</Color>

    <!-- Текст и значки поверх акцента -->
    <Color x:Key="OnAccentLight">#FFFFFF</Color>
    <Color x:Key="OnAccentDark">#0B1310</Color>

    <!-- Смысловые цвета: доход, расход и ошибка, перевод; их бледные фоны.
         Чистые и яркие, а не приглушённые: прежние кирпичный и болотный читались
         блёкло. Каждый держит контраст 4,5 и текстом на странице, и под подписью
         на своей заливке. Перевод — свой синий, а не цвет действия: иначе выбранный
         «Перевод» не отличался от кнопки «Сохранить» -->
    <Color x:Key="PositiveLight">#15784A</Color>
    <Color x:Key="PositiveDark">#5FD08F</Color>
    <Color x:Key="NegativeLight">#C9302C</Color>
    <Color x:Key="NegativeDark">#FF8A80</Color>
    <Color x:Key="TransferLight">#2259D6</Color>
    <Color x:Key="TransferDark">#8AB1FF</Color>
    <Color x:Key="NegativeBackgroundLight">#FBEEEE</Color>
    <Color x:Key="NegativeBackgroundDark">#453435</Color>
    <Color x:Key="PositiveBackgroundLight">#E3EFE9</Color>
    <Color x:Key="PositiveBackgroundDark">#284037</Color>

    <!-- Кружок переключателя -->
    <Color x:Key="KnobLight">#FFFFFF</Color>
    <Color x:Key="KnobDark">#E7EAEC</Color>

    <!-- Цвета счетов — палитра «Предельная насыщенность», заливка знака счёта.
         Порог — только значок на заливке, не ниже 3: к карточке заливка порога не
         имеет, счёт всегда подписан названием, а погоня за контрастом к карточке
         и сделала прежние цвета тусклыми. Имена — по AccountColor -->
    <Color x:Key="AccountBlueLight">#1F7BF5</Color>
    <Color x:Key="AccountBlueDark">#3082F6</Color>
    <Color x:Key="AccountOrangeLight">#E87F26</Color>
    <Color x:Key="AccountOrangeDark">#DB7823</Color>
    <Color x:Key="AccountSkyLight">#2CB0CA</Color>
    <Color x:Key="AccountSkyDark">#29A6BF</Color>
    <Color x:Key="AccountGreenLight">#2DBC55</Color>
    <Color x:Key="AccountGreenDark">#29B150</Color>
    <Color x:Key="AccountVioletLight">#994DF5</Color>
    <Color x:Key="AccountVioletDark">#9E59F6</Color>
    <Color x:Key="AccountMagentaLight">#F730F0</Color>
    <Color x:Key="AccountMagentaDark">#EC2DE4</Color>
    <Color x:Key="AccountRedLight">#F72C2E</Color>
    <Color x:Key="AccountRedDark">#F72C2E</Color>
    <Color x:Key="AccountPinkLight">#F62B97</Color>
    <Color x:Key="AccountPinkDark">#F62B97</Color>

    <!-- Атмосфера — фон экрана в стиле «Изумруд» (docs/ui/style.md): переход
         сверху вниз от мятного к почти белому, в тёмной — от глубокого зелёного
         к почти чёрному. Поверх него плывут пятна цветов Sky, Green и Accent -->
    <Color x:Key="BackdropTopLight">#CBEBE0</Color>
    <Color x:Key="BackdropMiddleLight">#E4F3EE</Color>
    <Color x:Key="BackdropBottomLight">#F5F9F8</Color>
    <Color x:Key="BackdropTopDark">#0D2A22</Color>
    <Color x:Key="BackdropMiddleDark">#0E1B18</Color>
    <Color x:Key="BackdropBottomDark">#0E1214</Color>

    <!-- Стекло на атмосфере тёмной темы: заливка и ободок клавиши цветом действия
         на просвет. В светлой теме клавиша — белая карточка с зелёной тенью.
         Прозрачные токены в ContrastTests не сверяются: текст на стекле сверяется
         по непрозрачному фону под ним (Backdrop*) -->
    <Color x:Key="GlassDark">#2648A78E</Color>
    <Color x:Key="GlassLineDark">#6148A78E</Color>

    <!-- Тень приподнятой поверхности — цветом действия, а не серая -->
    <Color x:Key="LiftShadowLight">#0F5C4C</Color>

    <!-- Кольцо, расходящееся от нажатой клавиши -->
    <Color x:Key="RippleLight">#590F5C4C</Color>
    <Color x:Key="RippleDark">#7348A78E</Color>

    <!-- Плашка под подписью ответа: держит контраст на любом месте пятен -->
    <Color x:Key="PillLight">#CCFFFFFF</Color>
    <Color x:Key="PillDark">#59000000</Color>

    <!-- Значок на заливке счёта — белый или тёмный, одинаково в обеих темах:
         какой из двух, решает цвет (AccountColors.TakesDarkGlyph) -->
    <Color x:Key="AccountGlyphWhite">#FFFFFF</Color>
    <Color x:Key="AccountGlyphInk">#16191C</Color>

</ResourceDictionary>
