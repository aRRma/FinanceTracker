<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Палитра тем. Эталон — переключатель темы в docs/ui/mockups.html: значения
    здесь обязаны совпадать с ним, иначе макет и приложение разойдутся, и сверить
    их будет не с чем.

    Прямые значения цвета живут только в этом файле. В разметке экранов их быть
    не должно: забытый там hex не переключается вместе с темой и находится
    потом глазами по всем страницам.

    Контраст текста к фону сверяет ContrastTests: новый токен текста
    добавляется и в таблицу пар того теста. Палитра приложения —
    подмножество палитры макетов: то, что нужно только рамке телефона
    и модальным окнам макета, здесь не повторяется.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Фон страницы -->
    <Color x:Key="PaperLight">#EDEFF1</Color>
    <Color x:Key="PaperDark">#101315</Color>

    <!-- Фон карточек, списков и нижней навигации -->
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1C2124</Color>

    <!-- Утопленные блоки: шапка даты, поле суммы, клавиши -->
    <Color x:Key="SunkLight">#F4F6F7</Color>
    <Color x:Key="SunkDark">#252B2F</Color>

    <!-- Текст: основной, вторичный, третичный -->
    <Color x:Key="InkLight">#16191C</Color>
    <Color x:Key="InkDark">#E7EAEC</Color>
    <Color x:Key="Ink2Light">#4C535A</Color>
    <Color x:Key="Ink2Dark">#A8AFB5</Color>
    <Color x:Key="Ink3Light">#676D74</Color>
    <Color x:Key="Ink3Dark">#8A9299</Color>

    <!-- Разделитель строк и граница карточки -->
    <Color x:Key="LineLight">#E3E6E9</Color>
    <Color x:Key="LineDark">#2F373C</Color>

    <!-- Акцент и его фон -->
    <Color x:Key="AccentLight">#0F5C4C</Color>
    <Color x:Key="AccentDark">#48A78E</Color>
    <Color x:Key="AccentBackgroundLight">#E2EFEB</Color>
    <Color x:Key="AccentBackgroundDark">#1B342D</Color>

    <!-- Текст и значки поверх акцента -->
    <Color x:Key="OnAccentLight">#FFFFFF</Color>
    <Color x:Key="OnAccentDark">#0B1310</Color>

    <!-- Смысловые цвета: доход, расход и ошибка, перевод; их бледные фоны.
         Чистые и яркие, а не приглушённые: прежние кирпичный и болотный читались
         блёкло. Каждый держит контраст 4,5 и текстом на странице, и под подписью
         на своей заливке. Перевод — свой синий, а не цвет действия: иначе выбранный
         «Перевод» не отличался от кнопки «Сохранить» -->
    <Color x:Key="PositiveLight">#15784A</Color>
    <Color x:Key="PositiveDark">#5FD08F</Color>
    <Color x:Key="NegativeLight">#C9302C</Color>
    <Color x:Key="NegativeDark">#FF8A80</Color>
    <Color x:Key="TransferLight">#2259D6</Color>
    <Color x:Key="TransferDark">#8AB1FF</Color>
    <Color x:Key="NegativeBackgroundLight">#FBEEEE</Color>
    <Color x:Key="NegativeBackgroundDark">#453435</Color>
    <Color x:Key="PositiveBackgroundLight">#E3EFE9</Color>
    <Color x:Key="PositiveBackgroundDark">#284037</Color>
    <Color x:Key="TransferBackgroundLight">#E4EBFA</Color>
    <Color x:Key="TransferBackgroundDark">#303B4B</Color>

    <!-- Кружок переключателя -->
    <Color x:Key="KnobLight">#FFFFFF</Color>
    <Color x:Key="KnobDark">#E7EAEC</Color>

</ResourceDictionary>
