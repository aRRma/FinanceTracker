<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="false" android:icon="@mipmap/launcher" android:supportsRtl="true"></application>
	<!-- Значок — свой адаптивный launcher.xml, а не собранный MauiIcon: только в нём плоский
	     монохромный слой для тематического значка (причина — в самом файле). roundIcon нет намеренно:
	     адаптивный значок лаунчер режет по своей маске сам, круглый вариант был бы тем же файлом -->
	<!-- Автоматический бэкап системы выключен: он восстановил бы базу
	     на другом устройстве из чужого по времени снимка, а сверить его с локальной
	     базой нечем — обмена между устройствами в MVP нет -->
	<!-- Разрешений на сеть нет намеренно: к сети приложение не обращается,
	     а обмен с сервером отложен целиком. Шаблон MAUI заводит INTERNET и
	     ACCESS_NETWORK_STATE сам — при обновлении шаблона их надо убирать снова -->
</manifest>