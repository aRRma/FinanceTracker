<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Заслонка с макетов C-10 и C-11: набор ПИН-кода на атмосфере, без шапки
    и вкладок. Рисуется в своём окне поверх всего приложения (LockCover), поэтому
    это не страница навигации, а содержимое окна.
-->
<ContentView
    x:Class="Finance.App.Controls.LockCoverView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:appLock="clr-namespace:Finance.Application.Infrastructure.AppLock;assembly=Finance.Application"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    x:DataType="appLock:PinPadViewModel">

    <Grid x:Name="Root">
        <!-- Атмосфера — от края до края, под строкой состояния и полосой навигации -->
        <controls:Backdrop IsDimmed="{Binding IsPaused}" />

        <!-- Отступы под системные полосы ставит окно заслонки (LockCover) через
             Inset, а не MAUI: в чужом окне он их не раздаёт -->
        <controls:PinPad x:Name="Pad" />
    </Grid>

</ContentView>
