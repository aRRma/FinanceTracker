<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Строка «Значок» и раскрывающаяся под ней сетка набора. Общая для карточек
    группы и подкатегории: поле там одно и то же, и вторая копия разошлась бы
    с первой.

    Сетка — FlexLayout, а не CollectionView: список со своей прокруткой внутри
    прокручиваемой формы отбирает у неё жест, а набор конечный — виртуализация
    ему не нужна.
-->
<ContentView
    x:Class="Finance.App.Controls.IconGrid"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:card="clr-namespace:Finance.Application.Features.Categories.Card;assembly=Finance.Application"
    x:DataType="card:IconPicker">

    <VerticalStackLayout Spacing="10">

        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="{StaticResource TouchTarget}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleCommand}" />
            </Grid.GestureRecognizers>

            <Label Grid.Column="0" Text="Значок" VerticalOptions="Center" />
            <controls:Icon Grid.Column="1" Key="{Binding Selected}" Style="{StaticResource AccentIcon}" />
        </Grid>

        <!-- Сетка раскрывается прямо под полем: отдельный экран ради одного выбора
             уводил бы с формы и терял набранное -->
        <FlexLayout IsVisible="{Binding IsOpen}" Wrap="Wrap" JustifyContent="Start" AlignContent="Start"
                    BindableLayout.ItemsSource="{Binding Choices}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="card:IconChoice">
                    <!-- Ячейка не меньше зоны касания, значок в её центре -->
                    <Grid WidthRequest="56" HeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnIconTapped" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Key="{Binding Key}" HorizontalOptions="Center">
                            <controls:Icon.Triggers>
                                <!-- Выбранный виден и в раскрытой сетке: иначе,
                                     открыв её, теряешь из виду то, что выбрано -->
                                <DataTrigger TargetType="controls:Icon" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke"
                                            Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                </DataTrigger>
                            </controls:Icon.Triggers>
                        </controls:Icon>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

    </VerticalStackLayout>

</ContentView>
