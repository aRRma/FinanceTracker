<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран A-04: справочники и настройки. Вкладка «Ещё» — главный вход во всё, что не
    балансы, операции и отчёт; к выгрузке ведёт ещё экран балансов, а к карточке
    счёта — лента счёта. Подписи считают содержимое:
    по ним видно, что справочник не пуст, ещё до захода в него.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.MorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:more="clr-namespace:Finance.Application.Features.More;assembly=Finance.Application"
    x:DataType="more:MoreViewModel"
    Title="{x:Static texts:UiTexts.MoreTitle}">

    <!-- Container: .NET 10 пускает страницу под системные полосы, а ScrollView
         из всех областей понимает только эту -->
    <ScrollView SafeAreaEdges="Container">
        <VerticalStackLayout Padding="16,12" Spacing="16">

            <Label Text="{x:Static texts:UiTexts.MoreCatalogs}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAccounts" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="wallet" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.AccountsTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding AccountsCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlaces" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="map-pin" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.PlacesTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding PlacesCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategories" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="tag" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.CategoriesTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding CategoriesCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static texts:UiTexts.MoreSettings}" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAppearance" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="sun" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.AppearanceTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding ThemeCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTimeZone" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="world" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.TimeZoneTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding TimeZoneCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDefaultAccount" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="credit-card" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.DefaultAccountTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding DefaultAccountCaption}"
                               LineBreakMode="TailTruncation" Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAppLock" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="lock" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.AppLockTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding AppLockCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExport" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="database" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.ExportTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{x:Static texts:UiTexts.MoreExportCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAbout" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.RowSpan="2" Margin="0,0,12,0" Key="info-circle" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{x:Static texts:UiTexts.AboutTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding AboutCaption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Grid.RowSpan="2" Key="chevron-right"
                                       Style="{StaticResource MutedIcon}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</pages:DataPage>
