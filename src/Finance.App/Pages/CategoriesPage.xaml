<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-03: справочник категорий. Расходы и доходы порознь: вместе список
    вдвое длиннее, а ищут в нём всегда что-то одно. «Прочее» и служебные видны,
    но не открываются — их не переносят и не удаляют.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:catalog="clr-namespace:Finance.Application.Features.Categories.Catalog;assembly=Finance.Application"
    xmlns:domain="clr-namespace:Finance.Domain.Enums;assembly=Finance.Domain"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    x:DataType="catalog:CategoriesViewModel"
    Title="{x:Static texts:UiTexts.CategoriesTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Clicked="OnCreateGroup" AutomationId="CreateGroup" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="*,*" ColumnSpacing="6"
              RadioButtonGroup.GroupName="categoryKind"
              RadioButtonGroup.SelectedValue="{Binding Kind}">
            <RadioButton Grid.Column="0" Content="{x:Static texts:UiTexts.KindExpensePlural}" Value="{x:Static domain:CategoryKind.Expense}" />
            <RadioButton Grid.Column="1" Content="{x:Static texts:UiTexts.KindIncomePlural}" Value="{x:Static domain:CategoryKind.Income}" />
        </Grid>

        <SearchBar Grid.Row="1" Text="{Binding Filter}" Placeholder="{x:Static texts:UiTexts.CommonSearchByName}" />

        <!-- Признак жеста свой, а не занятость модели: RefreshView на каждый его подъём
             запускает обновление, и чтение, поднявшее признак само, запускало бы второе.
             Обработчик, а не команда: сбой команды из разметки закрыл бы окно молча -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Refreshing="OnRefreshing">

            <!-- Список плоский, а не с группировкой: группировка прячет заголовок
                 вместе с содержимым, а свёрнутой группе заголовок как раз и нужен.
                 Шапка и строка различаются признаком, отступ второго уровня даёт
                 распорка слева -->
            <CollectionView ItemsSource="{Binding Lines}" SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="catalog:CategoryLine">
                        <Grid Padding="16,10" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLineTapped" />
                            </Grid.GestureRecognizers>

                            <BoxView Grid.Column="0" WidthRequest="24" Color="Transparent"
                                     IsVisible="{Binding IsSubcategory}" />

                            <controls:Icon Grid.Column="1" Key="{Binding Icon}" />

                            <Label Grid.Column="2" Text="{Binding Name}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <!-- Шапка группы крупнее строк: иначе уровни не различить -->
                                    <DataTrigger TargetType="Label" Binding="{Binding IsGroup}" Value="True">
                                        <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                    </DataTrigger>
                                    <!-- Приёмник и служебная приглушены: они не открываются -->
                                    <DataTrigger TargetType="Label" Binding="{Binding IsProtected}" Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <Border Grid.Column="3" Style="{StaticResource Badge}" IsVisible="{Binding IsGroup}">
                                <Label Text="{Binding Count}" Style="{StaticResource CaptionLabel}" />
                            </Border>

                            <!-- Шеврон со своей зоной касания: по строке открывается
                                 карточка группы, по шеврону — разворот. Знак шириной
                                 в два десятка точек пальцем не поймать -->
                            <Grid Grid.Column="4" Padding="12,0" IsVisible="{Binding IsGroup}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleTapped" />
                                </Grid.GestureRecognizers>

                                <controls:Icon Key="{Binding ChevronIcon}" Style="{StaticResource MutedIcon}"
                                               AutomationId="Chevron"
                                               SemanticProperties.Description="{x:Static texts:UiTexts.CategoriesExpandHint}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Пустое состояние — внутри списка: соседом в той же ячейке оно оказалось бы
                     под ним, и пустой список перехватывал бы касания поверх текста -->
                <CollectionView.EmptyView>
                    <ContentView>
                        <Label Padding="16,24" IsVisible="{Binding IsEmpty}"
                               Text="{x:Static texts:UiTexts.CommonNothingFound}"
                               Style="{StaticResource SecondaryLabel}" />
                    </ContentView>
                </CollectionView.EmptyView>

            </CollectionView>

        </RefreshView>

    </Grid>

</pages:DataPage>
