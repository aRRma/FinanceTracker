<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-08: часовой пояс. Зон в системе сотни, поэтому список отбирается
    по набранным буквам. Первой строкой — возврат к системному поясу: после
    ручного выбора вернуться к нему иначе нечем.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.TimeZonePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:zones="clr-namespace:Finance.Application.Features.Settings.TimeZones;assembly=Finance.Application"
    x:DataType="zones:TimeZoneViewModel"
    Title="{x:Static texts:UiTexts.TimeZoneTitle}">

    <Grid RowDefinitions="Auto,*">

        <SearchBar Grid.Row="0" Text="{Binding Filter}" Placeholder="{x:Static texts:UiTexts.TimeZoneSearchPlaceholder}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Zones}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="zones:TimeZoneOption">
                    <Grid Padding="16,10" ColumnDefinitions="*,Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoneTapped" />
                        </Grid.GestureRecognizers>
                        <Grid.Triggers>
                            <!-- Выбранное видно не только галочкой справа: в списке
                                 из сотен зон строка целиком находится быстрее -->
                            <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
                            </DataTrigger>
                        </Grid.Triggers>

                        <Label Grid.Column="0" Text="{Binding Caption}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Margin="8,0" Text="{Binding Offset}" VerticalOptions="Center"
                               Style="{StaticResource SecondaryLabel}" />
                        <controls:Icon Grid.Column="2" Key="check" IsVisible="{Binding IsSelected}"
                                       SemanticProperties.Description="{x:Static texts:UiTexts.CommonSelected}"
                                       Style="{StaticResource AccentIcon}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Подвалом, а не пустым состоянием списка: строка «Как в системе» стоит
                 в списке всегда, и пустым он не бывает — пустое состояние не показалось бы никогда -->
            <CollectionView.Footer>
                <Label Padding="16,24" IsVisible="{Binding IsFilteredOut}"
                       Text="{x:Static texts:UiTexts.CommonNothingFound}"
                       Style="{StaticResource SecondaryLabel}" />
            </CollectionView.Footer>
        </CollectionView>

    </Grid>

</pages:DataPage>
