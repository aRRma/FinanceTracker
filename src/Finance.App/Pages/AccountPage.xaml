<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-02: карточка счёта. Заведение и правка одной формой. Валюта заперта,
    если по счёту уже была операция, — рядом стоит пояснение почему, иначе
    заблокированное поле выглядит поломкой. Остаток набирается клавиатурой суммы,
    как в форме операции: разделитель, нули и минус не зависят от клавиатуры телефона.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:card="clr-namespace:Finance.Application.Features.Accounts.Card;assembly=Finance.Application"
    x:DataType="card:AccountViewModel"
    Title="{Binding Title}">

    <!--
        Сохранение и удаление — на панели заголовка, как в форме операции: снизу
        встаёт клавиатура суммы и закрыла бы кнопку внизу формы.
    -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,10,0" HorizontalOptions="Fill">
            <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource BarTitleLabel}" />
            <Button Grid.Column="1" Text="{x:Static texts:UiTexts.CommonDelete}" Style="{StaticResource BarDangerButton}"
                    IsVisible="{Binding IsExisting}" AutomationId="DeleteAccount" Clicked="OnDelete" />
            <Button Grid.Column="2" Text="{x:Static texts:UiTexts.CommonSave}" Style="{StaticResource BarSaveButton}"
                    IsEnabled="{Binding CanSave}" AutomationId="SaveAccount" Clicked="OnSave" />
        </Grid>
    </Shell.TitleView>

    <!-- Container: .NET 10 пускает страницу под системные полосы. Клавиатуру
         ScrollView не понимает вовсе, поэтому снизу её держит обёртка: без неё
         поле названия оставалось под системной клавиатурой -->
    <Grid RowDefinitions="*,Auto,Auto" SafeAreaEdges="Container, Container, Container, All">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12" Spacing="16">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="14,10" Spacing="10">
                        <Label Text="{x:Static texts:UiTexts.CommonName}" Style="{StaticResource CaptionLabel}" />
                        <Entry x:Name="NameEntry" Text="{Binding Name}" Placeholder="{Binding NamePlaceholder}"
                               Focused="OnNameFocused" />

                        <Label Text="{x:Static texts:UiTexts.AccountTypeLabel}" Style="{StaticResource CaptionLabel}" />
                        <Picker ItemsSource="{Binding TypeNames}" SelectedIndex="{Binding TypeIndex}" />

                        <Label Text="{x:Static texts:UiTexts.AccountCurrencyLabel}" Style="{StaticResource CaptionLabel}" />
                        <!-- Погашенный список касание не пропускает к родителю, поэтому
                             объяснение ловит прозрачная накладка поверх него -->
                        <Grid>
                            <Picker ItemsSource="{Binding CurrencyNames}" SelectedIndex="{Binding CurrencyIndex}"
                                    IsEnabled="{Binding CurrencyEditable}" />
                            <ContentView IsVisible="{Binding CurrencyLocked}" BackgroundColor="Transparent">
                                <ContentView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLockedCurrencyTapped" />
                                </ContentView.GestureRecognizers>
                            </ContentView>
                        </Grid>

                        <Label Text="{x:Static texts:UiTexts.AccountOpeningBalanceLabel}" Style="{StaticResource CaptionLabel}" />
                        <!-- Строка вместо поля ввода: системная клавиатура не открывается,
                             касание зовёт клавиатуру суммы. Черта под суммой подсвечена,
                             пока набирается остаток, — как поле в фокусе -->
                        <VerticalStackLayout Spacing="0"
                                             SemanticProperties.Description="{x:Static texts:UiTexts.AccountOpeningBalanceLabel}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpeningBalanceTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding OpeningBalanceDisplay}" AutomationId="OpeningBalance"
                                   FontSize="17" MinimumHeightRequest="{StaticResource TouchTarget}"
                                   VerticalTextAlignment="Center">
                                <Label.Triggers>
                                    <!-- Долг — цветом расхода. Цвет, а не стиль: кегль поля должен остаться -->
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOpeningBalanceNegative}" Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <BoxView Style="{StaticResource Divider}">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding AreKeysVisible}" Value="True">
                                        <Setter Property="HeightRequest" Value="2" />
                                        <Setter Property="Color"
                                                Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                        </VerticalStackLayout>

                        <Label Text="{x:Static texts:UiTexts.AccountOpenedOnLabel}" Style="{StaticResource CaptionLabel}" />
                        <DatePicker Date="{Binding OpenedOnDate}" MaximumDate="{Binding LatestOpeningDate}"
                                    Opened="OnOpenedOnPickerOpened" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="14,10" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Label Grid.Column="0" Text="{x:Static texts:UiTexts.AccountExcludeLabel}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ExcludedFromTotals}" />
                        </Grid>
                        <Label Text="{x:Static texts:UiTexts.AccountExcludeHint}"
                               Style="{StaticResource CaptionLabel}" />

                        <BoxView Style="{StaticResource Divider}" />

                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Label Grid.Column="0" Text="{x:Static texts:UiTexts.AccountClosedLabel}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding IsClosed}" />
                        </Grid>
                        <Label Text="{x:Static texts:UiTexts.AccountClosedHint}"
                               Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Нарушенное правило стоит над клавиатурой, а не в конце формы: внизу
             экрана оно видно всегда, и подводить к нему прокруткой не нужно -->
        <Border Grid.Row="1" Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}"
                Margin="16,0,16,8">
            <Label Padding="14,10" Text="{Binding Error}" Style="{StaticResource NegativeLabel}" />
        </Border>

        <controls:AmountKeypad Grid.Row="2" IsVisible="{Binding AreKeysVisible}"
                               KeyCommand="{Binding PressKeyCommand}"
                               BackspaceCommand="{Binding BackspaceCommand}"
                               EqualsCommand="{Binding EvaluateCommand}" />
    </Grid>

</pages:DataPage>
