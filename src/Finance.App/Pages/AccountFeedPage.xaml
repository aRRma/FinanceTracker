<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран A-03: лента одного счёта; C-03 — та же лента без операций. Пустая лента
    показывает строку начального остатка с датой открытия: иначе непонятно,
    откуда взялся баланс в шапке.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.AccountFeedPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:feed="clr-namespace:Finance.Application.Features.Feed;assembly=Finance.Application"
    x:DataType="feed:FeedViewModel"
    Title="{Binding AccountName}">

    <!-- Карандаш у названия открывает карточку счёта. Заголовок в своей панели
         тоже свой: штатный вместе с содержимым панели не показывается. При выделении
         место заголовка занимает шапка выделения -->
    <Shell.TitleView>
        <Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,10,0" HorizontalOptions="Fill">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsSelecting}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <!-- Знак счёта у названия: в строках ленты счёта жетонов нет, счёт один -->
                <controls:AccountBadge Grid.Column="0" Mode="Header" IsVisible="{Binding HasAccountMark}"
                                       Tone="{Binding AccountMark.Color}" IconKey="{Binding AccountMark.Icon}" />
                <Label Grid.Column="1" Text="{Binding AccountName}" Style="{StaticResource BarTitleLabel}"
                       LineBreakMode="TailTruncation" />
                <Border Grid.Column="2" Style="{StaticResource IconButton}"
                        SemanticProperties.Description="{x:Static texts:UiTexts.AccountEdit}" AutomationId="EditAccount">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEdit" />
                    </Border.GestureRecognizers>
                    <controls:Icon Key="pencil" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
            <controls:SelectionBar x:Name="Selection" IsVisible="{Binding IsSelecting}" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">

        <!-- Баланс строкой, а не карточкой: в макете он стоит подзаголовком
             у названия счёта, и четверть первого экрана под одно число не уходит -->
        <Grid Grid.Row="0" Padding="16,10" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="{x:Static texts:UiTexts.FeedBalance}" VerticalOptions="Center"
                   Style="{StaticResource SecondaryLabel}" />
            <Label Grid.Column="1" Text="{Binding AccountBalance}" VerticalOptions="Center"
                   FontFamily="OpenSansSemibold" FontSize="17">
                <Label.Triggers>
                    <!-- Цвет, а не стиль: начертание подзаголовка обязано остаться -->
                    <DataTrigger TargetType="Label" Binding="{Binding IsAccountBalanceNegative}" Value="True">
                        <Setter Property="TextColor"
                                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Grid>

        <controls:FeedList x:Name="List" Grid.Row="1">
            <controls:FeedList.Empty>
                <VerticalStackLayout Padding="16,12" Spacing="16" IsVisible="{Binding IsEmpty}">
                    <!-- Откуда взялся баланс в шапке, пока операций нет -->
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="14,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Label Grid.Column="0" Grid.Row="0" Text="{x:Static texts:UiTexts.FeedOpeningBalance}"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Label Grid.Column="0" Grid.Row="1" Text="{Binding OpenedOn}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Text="{Binding OpeningBalance}"
                                   VerticalOptions="Center" Style="{StaticResource SecondaryLabel}" />
                        </Grid>
                    </Border>

                    <VerticalStackLayout Padding="16,24" Spacing="12">
                        <Label Text="{x:Static texts:UiTexts.FeedEmptyTitle}" HorizontalTextAlignment="Center"
                               Style="{StaticResource TitleLabel}" />
                        <Label Text="{x:Static texts:UiTexts.FeedEmptyHint}"
                               HorizontalTextAlignment="Center" Style="{StaticResource SecondaryLabel}" />
                        <Button Text="{x:Static texts:UiTexts.FeedAddTransaction}" Clicked="OnAdd" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </controls:FeedList.Empty>
        </controls:FeedList>

        <!-- Пока лента пуста, добавлять предлагает кнопка в самом пустом состоянии -->
        <Button x:Name="AddButton" Grid.Row="1" Text="+" Clicked="OnAdd" IsVisible="{Binding HasItems}"
                Style="{StaticResource FloatingButton}"
                SemanticProperties.Description="{x:Static texts:UiTexts.FeedAddForAccountHint}" AutomationId="AddTransaction" />
    </Grid>

</pages:DataPage>
