<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экраны D-04 и D-07: карточка группы. У новой выбирается вид и показано, что
    будет создано; у существующей вид заперт — его наследуют все подкатегории,
    и смена перевернула бы знак у всей их истории.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.GroupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:card="clr-namespace:Finance.Application.Features.Categories.Card;assembly=Finance.Application"
    xmlns:catalog="clr-namespace:Finance.Application.Features.Categories.Catalog;assembly=Finance.Application"
    xmlns:domain="clr-namespace:Finance.Domain;assembly=Finance.Domain"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    x:DataType="card:GroupViewModel"
    Title="{Binding Title}">

    <!-- Container: .NET 10 пускает страницу под системные полосы, а ScrollView
         из всех областей понимает только эту -->
    <ScrollView SafeAreaEdges="Container">
        <VerticalStackLayout Padding="16,12" Spacing="16">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="14,10" Spacing="10">
                    <Label Text="Название" Style="{StaticResource CaptionLabel}" />
                    <Entry Text="{Binding Name}" Placeholder="Еда" />

                    <BoxView Style="{StaticResource Divider}" />

                    <controls:IconGrid BindingContext="{Binding Icon}" />

                    <BoxView Style="{StaticResource Divider}" />

                    <Label Text="Вид" Style="{StaticResource CaptionLabel}" />
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding KindEditable}"
                                           RadioButtonGroup.GroupName="groupKind"
                                           RadioButtonGroup.SelectedValue="{Binding Kind}">
                        <RadioButton Content="Расход" Value="{x:Static domain:CategoryKind.Expense}" />
                        <RadioButton Content="Доход" Value="{x:Static domain:CategoryKind.Income}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding KindCaption}" IsVisible="{Binding KindLocked}" />
                    <Label Text="Вид задаётся при создании и не меняется: его наследуют все подкатегории"
                           Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Превью новой группы: приёмник «Прочее» создаётся вместе с ней,
                 и узнать об этом лучше до сохранения, а не после -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowPreview}">
                <Label Text="Будет создано" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="14,10" Spacing="4">
                        <Label Text="{Binding Name}" />
                        <Label Text="{Binding PreviewCaption}" Style="{StaticResource SecondaryLabel}" />
                        <BoxView Style="{StaticResource Divider}" />
                        <Label Text="{Binding ReceiverName}" Style="{StaticResource SecondaryLabel}" />
                        <Label Text="Создаётся автоматически" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8" IsVisible="{Binding KindLocked}">
                <Label Text="Подкатегории" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Subcategories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="catalog:CategoryRowItem">
                                    <Grid Padding="14,12" MinimumHeightRequest="{StaticResource TouchTarget}">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSubcategoryTapped" />
                                        </Grid.GestureRecognizers>

                                        <Label Text="{Binding Name}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsProtected}" Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid Padding="14,12" MinimumHeightRequest="{StaticResource TouchTarget}"
                              IsVisible="{Binding CanAddSubcategory}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddSubcategory" />
                            </Grid.GestureRecognizers>

                            <Label Text="Добавить подкатегорию"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}">
                <Label Padding="14,10" Text="{Binding Error}" Style="{StaticResource NegativeLabel}" />
            </Border>

            <Button Text="Сохранить" Clicked="OnSave" IsEnabled="{Binding CanSave}"
                    Style="{StaticResource SaveButton}" AutomationId="SaveGroup" />

        </VerticalStackLayout>
    </ScrollView>

</pages:DataPage>
