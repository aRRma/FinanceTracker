<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран C-08: карточка места. Переименование правит все операции разом — ради
    этого место и сделано справочником. Удаление спрашивает подтверждение и
    называет, сколько операций останется без места: строки операций не правятся.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.PlacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:card="clr-namespace:Finance.Application.Features.Places.Card;assembly=Finance.Application"
    x:DataType="card:PlaceViewModel"
    Title="Место">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="16">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Padding="14,10" Spacing="10">
                    <Label Text="Название" Style="{StaticResource CaptionLabel}" />
                    <Entry Text="{Binding Name}" Placeholder="Пятёрочка" />

                    <Label Text="{Binding UsageCaption}" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasError}">
                <Label Padding="14,10" Text="{Binding Error}" Style="{StaticResource NegativeLabel}" />
            </Border>

            <Button Text="Сохранить" Clicked="OnSave" IsVisible="{Binding IsLoaded}" />

            <Button Text="Удалить место" Clicked="OnDelete" IsVisible="{Binding IsLoaded}"
                    Style="{StaticResource DangerButton}" />

        </VerticalStackLayout>
    </ScrollView>

</pages:DataPage>
