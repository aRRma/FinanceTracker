<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран C-08: карточка места. Переименование правит все операции разом — ради
    этого место и сделано справочником. Удаление спрашивает подтверждение и
    называет, сколько операций останется без места: строки операций не правятся.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.PlacePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:card="clr-namespace:Finance.Application.Features.Places.Card;assembly=Finance.Application"
    x:DataType="card:PlaceViewModel"
    Title="{x:Static texts:UiTexts.PlaceTitle}">

    <!-- Container: .NET 10 пускает страницу под системные полосы. Клавиатуру
         ScrollView не понимает вовсе, поэтому снизу её держит обёртка: без неё
         «Сохранить» оставалась под клавиатурой, и прокрутка до неё не доставала -->
    <Grid SafeAreaEdges="Container, Container, Container, All">
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="16">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="14,10" Spacing="10">
                        <Label Text="{x:Static texts:UiTexts.CommonName}" Style="{StaticResource CaptionLabel}" />
                        <Entry Text="{Binding Name}" Placeholder="{x:Static texts:UiTexts.PlaceNamePlaceholder}" />

                        <Label Text="{Binding UsageCaption}" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}">
                    <Label Padding="14,10" Text="{Binding Error}" Style="{StaticResource NegativeLabel}" />
                </Border>

                <Button Text="{x:Static texts:UiTexts.CommonSave}" Clicked="OnSave" IsVisible="{Binding IsLoaded}" IsEnabled="{Binding CanSave}"
                        Style="{StaticResource SaveButton}" AutomationId="SavePlace" />

                <Button Text="{x:Static texts:UiTexts.PlaceDelete}" Clicked="OnDelete" IsVisible="{Binding IsLoaded}" IsEnabled="{Binding IsIdle}"
                        AutomationId="DeletePlace"
                        Style="{StaticResource DangerButton}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</pages:DataPage>
