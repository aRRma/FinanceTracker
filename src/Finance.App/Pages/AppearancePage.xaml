<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-06: выбор темы. Три состояния, а не переключатель: вернуться
    к системной теме после ручного выбора иначе невозможно. Выбранное
    применяется сразу — подтверждением служит сам перекрасившийся экран.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:appearance="clr-namespace:Finance.Application.Features.Settings.Appearance;assembly=Finance.Application"
    x:DataType="appearance:AppearanceViewModel"
    Title="{x:Static texts:UiTexts.AppearanceTitle}">

    <!-- Container: .NET 10 пускает страницу под системные полосы, а ScrollView
         из всех областей понимает только эту -->
    <ScrollView SafeAreaEdges="Container">
        <VerticalStackLayout Padding="16,12" Spacing="16">

            <Label Text="{x:Static texts:UiTexts.AppearanceTheme}" Style="{StaticResource SectionLabel}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="appearance:ThemeOption">
                            <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                                  MinimumHeightRequest="{StaticResource TouchTarget}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeTapped" />
                                </Grid.GestureRecognizers>
                                <Grid.Triggers>
                                    <!-- Выбранное видно не только галочкой справа: строка целиком
                                         читается быстрее, чем значок на её краю -->
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <controls:Icon Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,12,0"
                                               Key="{Binding Icon}" />

                                <Label Grid.Column="1" Grid.Row="0" Text="{Binding Caption}" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Hint}"
                                       IsVisible="{Binding HasHint}"
                                       Style="{StaticResource SecondaryLabel}" />

                                <controls:Icon Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Key="check"
                                               IsVisible="{Binding IsSelected}"
                                               SemanticProperties.Description="{x:Static texts:UiTexts.CommonSelected}"
                                               Style="{StaticResource AccentIcon}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static texts:UiTexts.AppearanceHint}"
                   Style="{StaticResource SecondaryLabel}" />

        </VerticalStackLayout>
    </ScrollView>

</pages:DataPage>
