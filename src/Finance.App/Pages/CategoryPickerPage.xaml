<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран B-03: выбор подкатегории. Группы свёрнуты: подкатегорий шесть десятков,
    и сплошной список читать дольше, чем открыть нужную группу. Поиск раскрывает
    группы сам — набравшему название группы уже не нужны.

    Список плоский, а не с группировкой: группировка в MAUI прячет заголовок
    вместе с содержимым, а свёрнутой группе заголовок как раз и нужен. Шапка
    и строка различаются признаком, отступ второго уровня даёт распорка слева.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.CategoryPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:pick="clr-namespace:Finance.Application.Features.Transactions.Pick;assembly=Finance.Application"
    x:DataType="pick:CategoryPickerViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">

        <SearchBar Grid.Row="0" Text="{Binding Filter}" Placeholder="Поиск по названию" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Lines}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pick:CategoryPickerLine">
                    <Grid Padding="16,10" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLineTapped" />
                        </Grid.GestureRecognizers>
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
                            </DataTrigger>
                        </Grid.Triggers>

                        <!-- Отступ второго уровня: дерево показано отступом, а не рамками -->
                        <BoxView Grid.Column="0" WidthRequest="24" Color="Transparent"
                                 IsVisible="{Binding IsSubcategory}" />

                        <controls:Icon Grid.Column="1" Key="{Binding Icon}" />

                        <Label Grid.Column="2" Text="{Binding Name}" VerticalOptions="Center">
                            <Label.Triggers>
                                <!-- Приёмник и служебная приглушены: их выбирают редко -->
                                <DataTrigger TargetType="Label" Binding="{Binding IsProtected}" Value="True">
                                    <Setter Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Border Grid.Column="3" Style="{StaticResource Badge}" IsVisible="{Binding IsGroup}">
                            <Label Text="{Binding Count}" Style="{StaticResource CaptionLabel}" />
                        </Border>

                        <controls:Icon Grid.Column="4" Key="{Binding ChevronIcon}" IsVisible="{Binding IsGroup}"
                                       AutomationId="Chevron" Style="{StaticResource MutedIcon}" />

                        <controls:Icon Grid.Column="4" Key="check" IsVisible="{Binding IsSelected}"
                                       SemanticProperties.Description="Выбрано"
                                       Style="{StaticResource AccentIcon}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Пустое состояние — внутри списка: соседом в той же ячейке оно оказалось бы
                 под ним, и пустой список перехватывал бы касания поверх текста -->
            <CollectionView.EmptyView>
                <ContentView>
                    <Label Padding="16,24" IsVisible="{Binding IsEmpty}"
                           Text="Ни одна категория не подходит под набранные буквы."
                           Style="{StaticResource SecondaryLabel}" />
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</pages:DataPage>
