<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран B-03: выбор подкатегории. Группы свёрнуты: подкатегорий шесть десятков,
    и сплошной список читать дольше, чем открыть нужную группу. Поиск раскрывает
    группы сам — набравшему название группы уже не нужны. Над списком — панель
    частых подкатегорий: до привычной иначе разворот группы и прокрутка.

    Список плоский, а не с группировкой: группировка в MAUI прячет заголовок
    вместе с содержимым, а свёрнутой группе заголовок как раз и нужен. Шапка
    и строка различаются признаком, отступ второго уровня даёт распорка слева.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.CategoryPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:pick="clr-namespace:Finance.Application.Features.Transactions.Pick;assembly=Finance.Application"
    x:DataType="pick:CategoryPickerViewModel"
    Title="{Binding Title}"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <SearchBar Grid.Row="0" Text="{Binding Filter}" Placeholder="{x:Static texts:UiTexts.CommonSearchByName}" />

        <!--
            Панель частых: расход записывают несколько раз в день и почти всегда
            в одну из немногих подкатегорий. С первой буквой поиска панель уходит —
            набравший буквы ищет как раз не частое.

            Чипы лежат в своём слое: связанный список наполняет лэйаут целиком
            и стёр бы положенный рядом заголовок.
        -->
        <VerticalStackLayout Grid.Row="1" Padding="16,4,16,8" Spacing="6"
                             IsVisible="{Binding IsFrequentVisible}">
            <Label Text="{x:Static texts:UiTexts.PickCategoryFrequent}" Style="{StaticResource SectionLabel}" />

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Frequent}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="pick:CategoryPickerLine">
                            <Border Style="{StaticResource Chip}" Padding="10,6">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource ChipSelected}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLineTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout Spacing="6">
                                    <controls:Icon Key="{Binding Icon}" />
                                    <Label Text="{Binding Name}" Style="{StaticResource ChipLabel}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Style" Value="{StaticResource ChipSelectedLabel}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Lines}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="pick:CategoryPickerLine">
                    <Grid Padding="16,10" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLineTapped" />
                        </Grid.GestureRecognizers>
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource AccentBackgroundLight}, Dark={StaticResource AccentBackgroundDark}}" />
                            </DataTrigger>
                        </Grid.Triggers>

                        <!-- Отступ второго уровня: дерево показано отступом, а не рамками -->
                        <BoxView Grid.Column="0" WidthRequest="24" Color="Transparent"
                                 IsVisible="{Binding IsSubcategory}" />

                        <controls:Icon Grid.Column="1" Key="{Binding Icon}" />

                        <Label Grid.Column="2" Text="{Binding Name}" VerticalOptions="Center">
                            <Label.Triggers>
                                <!-- Приёмник и служебная приглушены: их выбирают редко -->
                                <DataTrigger TargetType="Label" Binding="{Binding IsProtected}" Value="True">
                                    <Setter Property="TextColor"
                                            Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Border Grid.Column="3" Style="{StaticResource Badge}" IsVisible="{Binding IsGroup}">
                            <Label Text="{Binding Count}" Style="{StaticResource CaptionLabel}" />
                        </Border>

                        <controls:Icon Grid.Column="4" Key="{Binding ChevronIcon}" IsVisible="{Binding IsGroup}"
                                       AutomationId="Chevron" Style="{StaticResource MutedIcon}" />

                        <controls:Icon Grid.Column="4" Key="check" IsVisible="{Binding IsSelected}"
                                       SemanticProperties.Description="{x:Static texts:UiTexts.CommonSelected}"
                                       Style="{StaticResource AccentIcon}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Пустое состояние — внутри списка: соседом в той же ячейке оно оказалось бы
                 под ним, и пустой список перехватывал бы касания поверх текста -->
            <CollectionView.EmptyView>
                <ContentView>
                    <Label Padding="16,24" IsVisible="{Binding IsEmpty}"
                           Text="{x:Static texts:UiTexts.CommonNothingFound}"
                           Style="{StaticResource SecondaryLabel}" />
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</pages:DataPage>
