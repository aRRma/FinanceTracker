<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран E-03: операции подкатегории за месяц. Те же строки, что в ленте,
    но отобранные по подкатегории и месяцу, без шапок дней. Строка открывает
    ту же карточку операции: отчёт — другой разрез тех же данных, а не их копия.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.ReportSubcategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:report="clr-namespace:Finance.Application.Features.Report;assembly=Finance.Application"
    x:DataType="report:ReportSubcategoryViewModel"
    Title="{Binding Name}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Label Grid.Row="0" Padding="16,12,16,0" Text="{Binding Caption}"
               Style="{StaticResource SecondaryLabel}" />

        <Label Grid.Row="1" Padding="16,4,16,8" Text="{Binding Total}" HorizontalTextAlignment="End"
               IsVisible="{Binding HasItems}" Style="{StaticResource TotalLabel}">
            <Label.Triggers>
                <!-- Цвет, а не стиль: у итога свой шрифт, и подмена стиля его потеряла бы -->
                <DataTrigger TargetType="Label" Binding="{Binding IsTotalExpense}" Value="True">
                    <Setter Property="TextColor"
                            Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsTotalExpense}" Value="False">
                    <Setter Property="TextColor"
                            Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="report:ReportTransactionItem">
                    <Grid Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Grid.Row="0" Text="{Binding Title}" />
                        <Label Grid.Column="0" Grid.Row="1" Text="{Binding Caption}"
                               Style="{StaticResource SecondaryLabel}" />
                        <Label Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Text="{Binding Amount}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPositive}" Value="True">
                                    <Setter Property="Style" Value="{StaticResource PositiveLabel}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                    <Setter Property="Style" Value="{StaticResource NegativeLabel}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Label Padding="16,12,16,24"
                       Text="Строка открывает ту же карточку операции, что и лента."
                       Style="{StaticResource CaptionLabel}" />
            </CollectionView.Footer>

            <!-- Пустое состояние — внутри списка: соседом в той же ячейке оно оказалось бы
                 под ним, и пустой список перехватывал бы касания поверх текста -->
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="32" Spacing="12"
                                         VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="В этом месяце операций нет" HorizontalTextAlignment="Center"
                               Style="{StaticResource TitleLabel}" />
                        <Label Text="Они переехали или удалены. Вернитесь к отчёту."
                               HorizontalTextAlignment="Center" Style="{StaticResource SecondaryLabel}" />
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</pages:DataPage>
