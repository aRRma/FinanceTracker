<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-05: справочник мест. Частые сверху: справочник наполняется сам и
    разрастается, а ищут в нём обычно то, чем пользуются. Заводить места отсюда
    нельзя — они появляются из формы операции. Подпись строки — подкатегория,
    в которой место встречается чаще всего; по ней дубль и виден.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.PlacesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:catalog="clr-namespace:Finance.Application.Features.Places.Catalog;assembly=Finance.Application"
    xmlns:queries="clr-namespace:Finance.Application.Infrastructure.Queries;assembly=Finance.Application"
    x:DataType="catalog:PlacesViewModel"
    Title="Места">

    <Grid RowDefinitions="Auto,*">

        <SearchBar Grid.Row="0" Text="{Binding Filter}" Placeholder="Поиск по названию" />

        <Label Grid.Row="1" Padding="16,24" IsVisible="{Binding IsEmpty}"
               Text="Мест пока нет. Они заводятся из формы операции и накапливаются сами — заходить сюда стоит, когда захочется навести порядок."
               Style="{StaticResource SecondaryLabel}" />

        <Label Grid.Row="1" Padding="16,24" IsVisible="{Binding IsFilteredOut}"
               Text="Ни одно место не подходит под набранные буквы."
               Style="{StaticResource SecondaryLabel}" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Places}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="queries:PlaceListItem">
                    <Grid Padding="16,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPlaceTapped" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Grid.Row="0" Text="{Binding Name}" />
                        <Label Grid.Column="0" Grid.Row="1" Text="{Binding TopCategoryName}"
                               IsVisible="{Binding HasTopCategory}"
                               Style="{StaticResource SecondaryLabel}" />
                        <Label Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                               Text="{Binding TransactionCount}" VerticalOptions="Center"
                               Style="{StaticResource SecondaryLabel}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</pages:DataPage>
