<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-05: справочник мест. Частые сверху: справочник наполняется сам и
    разрастается, а ищут в нём обычно то, чем пользуются. Заводить места отсюда
    нельзя — они появляются из формы операции. Подпись строки — подкатегория,
    в которой место встречается чаще всего; по ней дубль и виден.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.PlacesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:catalog="clr-namespace:Finance.Application.Features.Places.Catalog;assembly=Finance.Application"
    xmlns:queries="clr-namespace:Finance.Application.Infrastructure.Queries;assembly=Finance.Application"
    x:DataType="catalog:PlacesViewModel"
    Title="{x:Static texts:UiTexts.PlacesTitle}">

    <Grid RowDefinitions="Auto,*">

        <SearchBar Grid.Row="0" Text="{Binding Filter}" Placeholder="{x:Static texts:UiTexts.CommonSearchByName}" />

        <!-- Признак жеста свой, а не занятость модели: RefreshView на каждый его подъём
             запускает обновление, и чтение, поднявшее признак само, запускало бы второе.
             Обработчик, а не команда: сбой команды из разметки закрыл бы окно молча -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Refreshing="OnRefreshing">

            <CollectionView ItemsSource="{Binding Places}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="queries:PlaceListItem">
                        <Grid Padding="16,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                              RowDefinitions="Auto,Auto"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPlaceTapped" />
                            </Grid.GestureRecognizers>

                            <controls:Icon Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Key="map-pin" />

                            <Label Grid.Column="1" Grid.Row="0" Text="{Binding Name}" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{Binding TopCategoryName}"
                                   IsVisible="{Binding HasTopCategory}"
                                   Style="{StaticResource SecondaryLabel}" />

                            <!-- Счётчик плашкой: число рядом с названием того же
                                 начертания читалось бы как часть подписи -->
                            <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Badge}">
                                <Label Text="{Binding TransactionCount}" Style="{StaticResource CaptionLabel}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Пустое состояние — внутри списка: соседом в той же ячейке оно оказалось бы
                     под ним, и пустой список перехватывал бы касания поверх текста.
                     Два текста, потому что пустота бывает двух разных смыслов -->
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout>
                            <Label Padding="16,24" IsVisible="{Binding IsEmpty}"
                                   Text="{x:Static texts:UiTexts.PlacesEmpty}"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Label Padding="16,24" IsVisible="{Binding IsFilteredOut}"
                                   Text="{x:Static texts:UiTexts.CommonNothingFound}"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>

        </RefreshView>

    </Grid>

</pages:DataPage>
