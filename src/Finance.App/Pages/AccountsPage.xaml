<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-01: справочник счетов. Три раздела — доступные к тратам, накопления
    и закрытые; порядок внутри раздела задаётся перетаскиванием строки на строку.
    Удаления счёта нет: ненужный счёт закрывают, и он остаётся в ленте и отчёте.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.AccountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:catalog="clr-namespace:Finance.Application.Features.Accounts.Catalog;assembly=Finance.Application"
    x:DataType="catalog:AccountsViewModel"
    Title="Счета">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Clicked="OnCreateAccount" AutomationId="CreateAccount" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <DataTemplate x:Key="AccountRowTemplate" x:DataType="catalog:AccountRowItem">
            <Grid Padding="14,12" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10"
                  RowDefinitions="Auto,Auto"
                  MinimumHeightRequest="{StaticResource TouchTarget}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccountTapped" />
                    <DragGestureRecognizer DragStarting="OnDragStarting" />
                    <DropGestureRecognizer Drop="OnDrop" />
                </Grid.GestureRecognizers>

                <!-- Ручка говорит, что строку таскают: перетаскивание работает
                     по всей строке, но само по себе оно ничем не обозначено.
                     У закрытого счёта её место занимает замок — его не переставляют -->
                <controls:Icon Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Key="grip-vertical"
                               IsVisible="{Binding IsOpen}"
                               SemanticProperties.Description="Перетащить"
                               Style="{StaticResource MutedIcon}" />

                <controls:Icon Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Key="lock"
                               IsVisible="{Binding IsClosed}"
                               SemanticProperties.Description="Счёт закрыт"
                               Style="{StaticResource MutedIcon}" />

                <controls:Icon Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Key="{Binding Icon}" />

                <Label Grid.Column="2" Grid.Row="0" Text="{Binding Name}" />
                <Label Grid.Column="2" Grid.Row="1" Text="{Binding Caption}"
                       Style="{StaticResource SecondaryLabel}" />
                <Label Grid.Column="3" Grid.Row="0" Grid.RowSpan="2" Text="{Binding Balance}"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsNegative}" Value="True">
                            <Setter Property="Style" Value="{StaticResource NegativeLabel}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Тот же признак занятости гасит и ожидание первого чтения, и жест обновления -->
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <!-- Container: .NET 10 пускает страницу под системные полосы, а ScrollView
             из всех областей понимает только эту -->
        <ScrollView SafeAreaEdges="Container">
            <VerticalStackLayout Padding="16,12" Spacing="16">
                <Label Text="Доступно к тратам" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Spendable}"
                        BindableLayout.ItemTemplate="{StaticResource AccountRowTemplate}" />
                </Border>

                <!-- Пустой раздел не показывается: заголовок без единой строки под ним
                     читается как потерянные счета, а не как «накоплений нет» -->
                <Label Text="Накопления" Style="{StaticResource SectionLabel}"
                       IsVisible="{Binding HasSavings}" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasSavings}">
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Savings}"
                        BindableLayout.ItemTemplate="{StaticResource AccountRowTemplate}" />
                </Border>

                <Label Text="Закрытые" Style="{StaticResource SectionLabel}"
                       IsVisible="{Binding HasClosed}" />
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasClosed}">
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Closed}"
                        BindableLayout.ItemTemplate="{StaticResource AccountRowTemplate}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</pages:DataPage>
