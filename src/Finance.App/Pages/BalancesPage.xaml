<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран A-01: сколько доступно к тратам. Счета сгруппированы по валютам,
    в каждой валюте один подытог. Пока счетов нет — приглашение завести первый
    (экран C-06), и добавить операцию нельзя: записывать её некуда.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.BalancesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:balances="clr-namespace:Finance.Application.Features.Balances;assembly=Finance.Application"
    x:DataType="balances:BalancesViewModel"
    Title="Балансы">

    <ContentPage.Resources>
        <!-- Один шаблон на тратимые счета и на накопления: строка у них одинаковая,
             разное только то, входит ли счёт в подытог -->
        <DataTemplate x:Key="AccountTileTemplate" x:DataType="balances:AccountTile">
            <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                  MinimumHeightRequest="{StaticResource TouchTarget}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccountTapped" />
                </Grid.GestureRecognizers>

                <!-- Значок вместо подписи типа: наличные от карты отличают
                     взглядом, а строка остаётся однострочной -->
                <controls:Icon Grid.Column="0" Key="{Binding Icon}" />

                <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center">
                    <Label.Triggers>
                        <!-- Накопления приглушены: в подытог они не входят -->
                        <DataTrigger TargetType="Label" Binding="{Binding IsSavings}" Value="True">
                            <Setter Property="TextColor"
                                    Value="{AppThemeBinding Light={StaticResource Ink2Light}, Dark={StaticResource Ink2Dark}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label Grid.Column="2" Text="{Binding Balance}"
                       VerticalOptions="Center" Style="{StaticResource AmountLabel}">
                    <Label.Triggers>
                        <!-- Минус на счёте — смысловым цветом: обычным текстом его
                             не отличить от обычного остатка (NFR-25) -->
                        <DataTrigger TargetType="Label" Binding="{Binding IsNegative}" Value="True">
                            <Setter Property="Style" Value="{StaticResource AmountNegativeLabel}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <!-- Тот же признак занятости гасит и ожидание первого чтения, и жест обновления -->
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <ScrollView IsVisible="{Binding HasAccounts}" SafeAreaEdges="Container">
                <!-- Разделы валют лежат своим слоем: BindableLayout наполняет
                     layout целиком и стёр бы соседей, оказавшихся рядом с ним -->
                <VerticalStackLayout Padding="16,12,16,12" Spacing="20">
                    <VerticalStackLayout Spacing="20"
                                         BindableLayout.ItemsSource="{Binding Sections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="balances:CurrencySection">
                                <VerticalStackLayout Spacing="8">
                                    <!-- Валюта и «доступно» в одну строку, число под ними справа:
                                         три подписи столбиком читались как три разных заголовка -->
                                    <Grid ColumnDefinitions="*,Auto" Padding="2,0">
                                        <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource SectionLabel}" />
                                        <Label Grid.Column="1" Text="Доступно" Style="{StaticResource SectionLabel}" />
                                    </Grid>
                                    <Label Text="{Binding Available}" Style="{StaticResource TotalLabel}"
                                           HorizontalTextAlignment="End" Padding="2,0">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsAvailableNegative}" Value="True">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Border Style="{StaticResource Card}">
                                        <VerticalStackLayout
                                            BindableLayout.ItemsSource="{Binding Spendable}"
                                            BindableLayout.ItemTemplate="{StaticResource AccountTileTemplate}" />
                                    </Border>

                                    <Label Text="Накопления" Style="{StaticResource SectionLabel}"
                                           IsVisible="{Binding HasSavings}" />
                                    <Label Text="Скрыты из расчётов" Style="{StaticResource CaptionLabel}"
                                           IsVisible="{Binding HasSavings}" />

                                    <Border Style="{StaticResource Card}" IsVisible="{Binding HasSavings}">
                                        <VerticalStackLayout
                                            BindableLayout.ItemsSource="{Binding Savings}"
                                            BindableLayout.ItemTemplate="{StaticResource AccountTileTemplate}" />
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Завести счёт можно и отсюда: справочник за вкладкой «Ещё»
                         ищут долго, а второй счёт заводят, глядя как раз на балансы.
                         Строкой, а не второй плавающей кнопкой: плавающая уже занята
                         операцией, и две одинаковые кнопки рядом не различить -->
                    <Border Style="{StaticResource Card}">
                        <Grid Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCreateAccount" />
                            </Grid.GestureRecognizers>

                            <controls:Icon Grid.Column="0" Key="plus" Style="{StaticResource AccentIcon}" />
                            <Label Grid.Column="1" Text="Добавить счёт" VerticalOptions="Center"
                                   AutomationId="AddAccount"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </Grid>
                    </Border>

                    <!-- Место под плавающую кнопку: последний счёт не должен прятаться за ней -->
                    <BoxView HeightRequest="{StaticResource FloatingButtonClearance}" Color="Transparent" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Первый запуск: счетов нет, и единственное осмысленное действие — завести счёт.
             До конца чтения не показывается: иначе мигало бы на каждом заходе -->
        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="32" Spacing="12"
                             VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="Заведите первый счёт" HorizontalTextAlignment="Center"
                   Style="{StaticResource TitleLabel}" />
            <Label Text="Категории уже созданы — останется записать первую операцию."
                   HorizontalTextAlignment="Center" Style="{StaticResource SecondaryLabel}" />
            <Button Text="Создать счёт" Clicked="OnCreateAccount" AutomationId="CreateFirstAccount" />
        </VerticalStackLayout>

        <!-- Пока счетов нет, записывать операцию некуда — кнопки нет. С подписью,
             а не одним знаком: строка «Добавить счёт» рядом тоже начинается с плюса,
             и два одинаковых плюса на экране не различить -->
        <Button Text="+  Операция" Clicked="OnAddTransaction" IsVisible="{Binding HasAccounts}"
                Style="{StaticResource ExtendedFloatingButton}"
                SemanticProperties.Description="Записать операцию" AutomationId="AddTransaction" />
    </Grid>

</pages:DataPage>
