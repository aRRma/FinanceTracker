<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран C-02: карточка подкатегории. Группа выбирается списком — смена группы
    и есть перенос. Вид показан, но заперт: он наследуется от группы. Удаление
    спрашивает подтверждение и называет, сколько операций переедет и куда.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.SubcategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:card="clr-namespace:Finance.Application.Features.Categories.Card;assembly=Finance.Application"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    x:DataType="card:SubcategoryViewModel"
    Title="{Binding Title}">

    <!-- Container: .NET 10 пускает страницу под системные полосы. Клавиатуру
         ScrollView не понимает вовсе, поэтому снизу её держит обёртка: без неё
         «Сохранить» оставалась под клавиатурой, и прокрутка до неё не доставала -->
    <Grid SafeAreaEdges="Container, Container, Container, All">
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="16">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Padding="14,10" Spacing="10">
                        <Label Text="{x:Static texts:UiTexts.CommonName}" Style="{StaticResource CaptionLabel}" />
                        <Entry Text="{Binding Name}" Placeholder="{x:Static texts:UiTexts.SubcategoryNamePlaceholder}" />

                        <controls:IconGrid BindingContext="{Binding Icon}" />

                        <Label Text="{x:Static texts:UiTexts.SubcategoryGroupLabel}" Style="{StaticResource CaptionLabel}" />
                        <!-- Только группы того же вида: перенос в чужой вид перевернул бы
                             знак у всей истории подкатегории -->
                        <Picker ItemsSource="{Binding Groups}"
                                ItemDisplayBinding="{Binding Name, x:DataType=card:CategoryGroupOption}"
                                SelectedItem="{Binding Group}" Title="{x:Static texts:UiTexts.SubcategoryChooseGroup}" />

                        <Label Text="{x:Static texts:UiTexts.CommonKind}" Style="{StaticResource CaptionLabel}" />
                        <Label Text="{Binding KindCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}">
                    <Label Padding="14,10" Text="{Binding Error}" Style="{StaticResource NegativeLabel}" />
                </Border>

                <Button Text="{x:Static texts:UiTexts.CommonSave}" Clicked="OnSave" IsEnabled="{Binding CanSave}"
                        Style="{StaticResource SaveButton}" AutomationId="SaveSubcategory" />

                <Button Text="{x:Static texts:UiTexts.SubcategoryDelete}" Clicked="OnDelete" IsVisible="{Binding CanDelete}" IsEnabled="{Binding IsIdle}"
                        AutomationId="DeleteSubcategory"
                        Style="{StaticResource DangerButton}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</pages:DataPage>
