<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран D-09: «О программе». Версия приложения и номер схемы базы — по ним
    сверяют, накатилась ли миграция после обновления. Здесь же лицензия набора
    значков: он поставляется в составе приложения.

    Оформлен в стиле «Изумруд»: атмосфера экрана ПИН-кода под всем экраном и знак
    приложения без плитки — неоновый в тёмной теме, дневной в светлой (неон на
    светлом гаснет). Пояснения лежат в карточке, а не на атмосфере: пятна плывут,
    и мелкий текст попадал бы на разные участки.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:about="clr-namespace:Finance.Application.Features.Settings.About;assembly=Finance.Application"
    x:DataType="about:AboutViewModel"
    Title="{x:Static texts:UiTexts.AboutTitle}">

    <!-- Атмосфера — от края до края страницы, содержимое — в безопасной области -->
    <Grid SafeAreaEdges="None">
        <controls:Backdrop />

        <!-- Container: .NET 10 пускает страницу под системные полосы, а ScrollView
             из всех областей понимает только эту -->
        <ScrollView SafeAreaEdges="Container">
            <VerticalStackLayout Padding="16,12" Spacing="16">

                <VerticalStackLayout Spacing="4" Margin="0,8,0,4">
                    <!-- Знак — украшение: название под ним озвучивается само -->
                    <Image Source="{AppThemeBinding Light=about_mark_light.png, Dark=about_mark_dark.png}"
                           WidthRequest="220" HeightRequest="220"
                           HorizontalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <Label Text="{x:Static texts:UiTexts.AboutAppName}" Style="{StaticResource TitleLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Padding="14,12" ColumnDefinitions="*,Auto"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Label Grid.Column="0" Text="{x:Static texts:UiTexts.AboutVersion}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Version}" VerticalOptions="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                        </Grid>

                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Padding="14,12" ColumnDefinitions="*,Auto"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Label Grid.Column="0" Text="{x:Static texts:UiTexts.AboutSchema}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Schema}" VerticalOptions="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                        </Grid>

                        <BoxView Style="{StaticResource Divider}" />

                        <Grid Padding="14,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCrashReportsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{x:Static texts:UiTexts.CrashReportsTitle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding CrashReportCount}" VerticalOptions="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                            <controls:Icon Grid.Column="2" Key="chevron-right" VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{StaticResource Divider}" />

                        <VerticalStackLayout Padding="14,12" Spacing="8">
                            <Label Text="{x:Static texts:UiTexts.AboutPrivacy}"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Label Text="{x:Static texts:UiTexts.AboutIcons}"
                                   Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</pages:DataPage>
