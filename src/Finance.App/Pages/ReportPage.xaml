<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экраны E-01 и E-04: отчёт за месяц по группам. Полоса под строкой даёт
    сравнение глазом, без чтения процентов. Пустое состояние вместо списка нулей:
    строки по нулю рублей читаются как ошибка расчёта, а не как отсутствие трат.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.ReportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:report="clr-namespace:Finance.Application.Features.Report;assembly=Finance.Application"
    xmlns:domain="clr-namespace:Finance.Domain.Enums;assembly=Finance.Domain"
    x:DataType="report:ReportViewModel"
    Title="{x:Static texts:UiTexts.ReportTitle}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Своим цветом и знаком, как вид операции в форме: общая плашка цветом
             действия под словом «Расходы» читалась цветом дохода -->
        <Border Grid.Row="0" Margin="16,12,16,4" Style="{StaticResource SegmentBar}">
            <Grid ColumnDefinitions="*,*" HeightRequest="{StaticResource TouchTarget}"
                  RadioButtonGroup.GroupName="reportKind"
                  RadioButtonGroup.SelectedValue="{Binding Kind}">
                <RadioButton Grid.Column="0" Content="{x:Static texts:UiTexts.KindExpensePlural}" Value="{x:Static domain:CategoryKind.Expense}"
                             ControlTemplate="{StaticResource ExpenseSegmentTemplate}" />
                <RadioButton Grid.Column="1" Content="{x:Static texts:UiTexts.KindIncomePlural}" Value="{x:Static domain:CategoryKind.Income}"
                             ControlTemplate="{StaticResource IncomeSegmentTemplate}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Padding="16,4" ColumnDefinitions="Auto,*,Auto">
            <!-- Стрелки — круглые кнопки со значком. Знак ничего не говорит вслух:
                 описание обязательно. Шеврон один, «назад» — тот же, повёрнутый -->
            <Border Grid.Column="0" Style="{StaticResource IconButton}"
                    SemanticProperties.Description="{x:Static texts:UiTexts.ReportPreviousMonth}" AutomationId="PreviousMonth">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPreviousMonth" />
                </Border.GestureRecognizers>
                <controls:Icon Key="chevron-right" Rotation="180" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="{Binding MonthTitle}" HorizontalTextAlignment="Center"
                   VerticalOptions="Center" FontFamily="OpenSansSemibold" />
            <Border Grid.Column="2" Style="{StaticResource IconButton}"
                    SemanticProperties.Description="{x:Static texts:UiTexts.ReportNextMonth}" AutomationId="NextMonth"
                    IsEnabled="{Binding CanGoForward}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNextMonth" />
                </Border.GestureRecognizers>
                <!-- На текущем месяце стрелка гаснет: операций в будущем не бывает -->
                <controls:Icon Key="chevron-right" HorizontalOptions="Center" VerticalOptions="Center">
                    <controls:Icon.Triggers>
                        <DataTrigger TargetType="controls:Icon" Binding="{Binding CanGoForward}" Value="False">
                            <Setter Property="Stroke"
                                    Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </DataTrigger>
                    </controls:Icon.Triggers>
                </controls:Icon>
            </Border>
        </Grid>

        <Label Grid.Row="2" Padding="16,4,16,8" Text="{Binding Total}" HorizontalTextAlignment="End"
               IsVisible="{Binding HasItems}" Style="{StaticResource TotalLabel}">
            <Label.Triggers>
                <!-- Цвет, а не стиль: у итога свой шрифт, и подмена стиля его потеряла бы -->
                <DataTrigger TargetType="Label" Binding="{Binding IsTotalExpense}" Value="True">
                    <Setter Property="TextColor"
                            Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsTotalExpense}" Value="False">
                    <Setter Property="TextColor"
                            Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <!-- Признак жеста свой, а не занятость модели: RefreshView на каждый его подъём
             запускает обновление, и чтение, поднявшее признак само, запускало бы второе.
             Обработчик, а не команда: сбой команды из разметки закрыл бы окно молча -->
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Refreshing="OnRefreshing">

            <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="report:ReportRowItem">
                        <Grid Padding="16,10,16,6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                              RowDefinitions="Auto,Auto" RowSpacing="6"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" />
                            </Grid.GestureRecognizers>

                            <controls:Icon Grid.Column="0" Grid.Row="0" Key="{Binding Icon}" />
                            <Label Grid.Column="1" Grid.Row="0" Text="{Binding Name}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Grid.Row="0" Text="{Binding Amount}" VerticalOptions="Center"
                                   Style="{StaticResource AmountLabel}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource AmountNegativeLabel}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="False">
                                        <Setter Property="Style" Value="{StaticResource AmountPositiveLabel}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Column="3" Grid.Row="0" Text="{Binding Share}" VerticalOptions="Center"
                                   MinimumWidthRequest="40" HorizontalTextAlignment="End"
                                   Style="{StaticResource AmountSectionLabel}" />
                            <ProgressBar Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3"
                                         Progress="{Binding Fraction}" IsVisible="{Binding HasShare}" HeightRequest="4"
                                         ProgressColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <Label Padding="16,12,16,24"
                           Text="{x:Static texts:UiTexts.ReportHint}"
                           Style="{StaticResource CaptionLabel}" />
                </CollectionView.Footer>

                <!-- Пустое состояние — внутри списка: соседом в той же ячейке оно оказалось бы
                     под ним, и пустой список перехватывал бы касания поверх текста -->
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="32" Spacing="12"
                                             VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="{Binding EmptyTitle}" HorizontalTextAlignment="Center"
                                   Style="{StaticResource TitleLabel}" />
                            <Label Text="{Binding EmptyHint}" IsVisible="{Binding HasEmptyHint}"
                                   HorizontalTextAlignment="Center" Style="{StaticResource SecondaryLabel}" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>

        </RefreshView>

    </Grid>

</pages:DataPage>
