<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экраны B-01, B-05, B-06: форма операции — запись и правка одной формой;
    C-01 — та же форма с нарушенным правилом; C-07 — удаление с подтверждением.
    Форма перестраивается по виду: у перевода второй счёт вместо категории и места,
    вторая сумма — только при разных валютах счетов. Клавиатура суммы прижата
    к низу и открыта сразу: сумму меняют всегда. Сохранение — на панели заголовка.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.TransactionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:card="clr-namespace:Finance.Application.Features.Transactions.Card;assembly=Finance.Application"
    xmlns:domain="clr-namespace:Finance.Domain.Enums;assembly=Finance.Domain"
    x:DataType="card:TransactionViewModel"
    Title="{Binding Title}"
    Shell.TabBarIsVisible="False">

    <!--
        Панель заголовка своя: сохранение — зелёная клавиша у правого края,
        удаление рядом подписью. Штатный ToolbarItem фона не имеет, а с клавиатуры
        сохранение ушло: она уходит с экрана целиком, пока набирают заметку,
        и уносила бы сохранение с собой.
    -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,10,0" HorizontalOptions="Fill">
            <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource BarTitleLabel}" />
            <Button Grid.Column="1" Text="{x:Static texts:UiTexts.CommonDelete}" Style="{StaticResource BarDangerButton}"
                    IsVisible="{Binding IsExisting}" AutomationId="DeleteTransaction" Clicked="OnDelete" />
            <Button Grid.Column="2" Text="{x:Static texts:UiTexts.CommonSave}" Style="{StaticResource BarSaveButton}"
                    IsEnabled="{Binding CanSave}" AutomationId="SaveTransaction" Clicked="OnSave" />
        </Grid>
    </Shell.TitleView>

    <!--
        Клавиатура прижата к низу, а в .NET 10 страница по умолчанию идёт от края
        до края: без этого нижний ряд клавиш уезжает под жестовую полосу, а при
        наборе заметки — под системную клавиатуру.
    -->
    <Grid RowDefinitions="*,Auto,Auto" SafeAreaEdges="Container, Container, Container, All">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,12" Spacing="16">

                <!-- Вид операции. По умолчанию расход — он записывается чаще всего.
                     У каждого вида свой цвет и свой знак: три одинаковых слова
                     читаются как подпись, а не как выбор -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6"
                      RadioButtonGroup.GroupName="kind"
                      RadioButtonGroup.SelectedValue="{Binding Kind}">
                    <RadioButton Grid.Column="0" Content="{x:Static texts:UiTexts.KindExpense}" Value="{x:Static domain:TransactionKind.Expense}"
                                 ControlTemplate="{StaticResource ExpenseSegmentTemplate}" />
                    <RadioButton Grid.Column="1" Content="{x:Static texts:UiTexts.KindIncome}" Value="{x:Static domain:TransactionKind.Income}"
                                 ControlTemplate="{StaticResource IncomeSegmentTemplate}" />
                    <RadioButton Grid.Column="2" Content="{x:Static texts:UiTexts.KindTransfer}" Value="{x:Static domain:TransactionKind.Transfer}"
                                 ControlTemplate="{StaticResource TransferSegmentTemplate}" />
                </Grid>

                <!-- Набранное выражение сверху, его итог под ним: считать в уме при
                     разделе счёта не приходится, а сохраняется именно итог. Итог
                     незакрытого действия показывает клавиша «=» -->
                <Border Style="{StaticResource AmountField}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSourceAmountActive}" Value="True">
                            <Setter Property="Stroke"
                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ActivateSourceAmountCommand}" />
                    </Border.GestureRecognizers>

                    <!-- Итог — главная цифра экрана, по центру и крупно; набранное
                         выражение над ним мелким. Пока ничего не набрано, итог показывает
                         ноль в валюте: пустая рамка читалась как поломка. С незакрытым
                         действием итога нет — вместо него видно само выражение -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static texts:UiTexts.TransactionAmount}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding AmountDisplay}" Style="{StaticResource AmountExpression}" />
                        <Label Text="{Binding AmountPreview}" Style="{StaticResource AmountHero}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AmountField}" IsVisible="{Binding NeedsTargetAmount}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsTargetAmountActive}" Value="True">
                            <Setter Property="Stroke"
                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ActivateTargetAmountCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static texts:UiTexts.TransactionTargetAmount}" Style="{StaticResource CaptionLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding TargetAmountDisplay}" Style="{StaticResource AmountExpression}" />
                        <Label Text="{Binding TargetAmountPreview}" Style="{StaticResource AmountHero}" />
                    </VerticalStackLayout>
                </Border>

                <!--
                    Счёт, категория и место выбираются на своих экранах: списков
                    здесь по полсотни строк, и системный выпадающий список показывал
                    бы их сплошняком, без групп, значков и поиска. В форме остаётся
                    строка со значением и знаком перехода.
                -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickAccount" />
                            </Grid.GestureRecognizers>

                            <controls:Icon Grid.Column="0" Key="wallet" Style="{StaticResource MutedIcon}" />
                            <Label Grid.Column="1" Text="{Binding SourceLabel}" VerticalOptions="Center"
                                   Style="{StaticResource SecondaryLabel}" />
                            <Label Grid.Column="2" Text="{Binding SourceAccountCaption}" VerticalOptions="Center" />
                            <controls:Icon Grid.Column="3" Key="chevron-right" Style="{StaticResource MutedIcon}" />
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding IsTransfer}">
                            <BoxView Style="{StaticResource Divider}" />

                            <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                                  MinimumHeightRequest="{StaticResource TouchTarget}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickTargetAccount" />
                                </Grid.GestureRecognizers>

                                <controls:Icon Grid.Column="0" Key="swap" Style="{StaticResource MutedIcon}" />
                                <Label Grid.Column="1" Text="{x:Static texts:UiTexts.TransactionTarget}" VerticalOptions="Center"
                                       Style="{StaticResource SecondaryLabel}" />
                                <Label Grid.Column="2" Text="{Binding TargetAccountCaption}" VerticalOptions="Center" />
                                <controls:Icon Grid.Column="3" Key="chevron-right" Style="{StaticResource MutedIcon}" />
                            </Grid>

                            <Label Padding="14,0,14,10" Text="{x:Static texts:UiTexts.TransactionTransferHint}"
                                   Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding IsNotTransfer}">
                            <BoxView Style="{StaticResource Divider}" />

                            <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                                  MinimumHeightRequest="{StaticResource TouchTarget}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickCategory" />
                                </Grid.GestureRecognizers>

                                <controls:Icon Grid.Column="0" Key="tag" Style="{StaticResource MutedIcon}" />
                                <Label Grid.Column="1" Text="{x:Static texts:UiTexts.TransactionCategory}" VerticalOptions="Center"
                                       Style="{StaticResource SecondaryLabel}" />
                                <Label Grid.Column="2" Text="{Binding CategoryCaption}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <!-- Невыбранная категория подписана приглушённо: это
                                             приглашение, а не значение поля -->
                                        <DataTrigger TargetType="Label" Binding="{Binding HasCategory}" Value="False">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <controls:Icon Grid.Column="3" Key="chevron-right" Style="{StaticResource MutedIcon}" />
                            </Grid>

                            <BoxView Style="{StaticResource Divider}" />

                            <Grid Padding="14,12" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                                  MinimumHeightRequest="{StaticResource TouchTarget}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickPlace" />
                                </Grid.GestureRecognizers>

                                <controls:Icon Grid.Column="0" Key="map-pin" Style="{StaticResource MutedIcon}" />
                                <Label Grid.Column="1" Text="{x:Static texts:UiTexts.TransactionPlace}" VerticalOptions="Center"
                                       Style="{StaticResource SecondaryLabel}" />
                                <Label Grid.Column="2" Text="{Binding PlaceCaption}" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasPlace}" Value="False">
                                            <Setter Property="Style" Value="{StaticResource CaptionLabel}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <controls:Icon Grid.Column="3" Key="chevron-right" Style="{StaticResource MutedIcon}" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <!--
                            Дата — строкой в ряд с остальными полями: подпись, чипы
                            «Сегодня» и «Вчера», третий чип открывает календарь.
                            Системный календарь с подчёркиванием в форме не показывается:
                            он чужой для остального оформления, а «Сегодня / Вчера»
                            под ним уезжали под клавиатуру.
                        -->
                        <Grid Padding="14,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <controls:Icon Grid.Column="0" Key="calendar" Style="{StaticResource MutedIcon}" />
                            <Label Grid.Column="1" Text="{Binding OccurredOnCaption}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                <Border Style="{StaticResource Chip}" AutomationId="DateToday">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource ChipSelected}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetTodayCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static texts:UiTexts.TransactionToday}" Style="{StaticResource ChipLabel}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Style" Value="{StaticResource ChipSelectedLabel}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Style="{StaticResource Chip}" AutomationId="DateYesterday">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsYesterday}" Value="True">
                                            <Setter Property="Style" Value="{StaticResource ChipSelected}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetYesterdayCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{x:Static texts:UiTexts.TransactionYesterday}" Style="{StaticResource ChipLabel}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsYesterday}" Value="True">
                                                <Setter Property="Style" Value="{StaticResource ChipSelectedLabel}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Style="{StaticResource Chip}" AutomationId="DateOther"
                                        SemanticProperties.Description="{x:Static texts:UiTexts.TransactionCalendarHint}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPickDate" />
                                    </Border.GestureRecognizers>
                                    <Label Text="…" Style="{StaticResource ChipLabel}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Календарь живёт на экране невидимым: открыть системный диалог
                             можно только через сам контрол, и убрать его из дерева нельзя.
                             Будущие дни и дни раньше открытия счёта он не предлагает -->
                        <DatePicker x:Name="Calendar" Date="{Binding OccurredOnDate}"
                                    MinimumDate="{Binding EarliestDate}"
                                    MaximumDate="{Binding LatestDate}"
                                    Opacity="0" HeightRequest="1" MinimumHeightRequest="1" InputTransparent="True" />

                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Padding="14,4,14,4" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <controls:Icon Grid.Column="0" Key="pencil" Style="{StaticResource MutedIcon}" />
                            <Entry Grid.Column="1" Text="{Binding Note}" Placeholder="{x:Static texts:UiTexts.TransactionNotePlaceholder}"
                                   Focused="OnTextFocused" Unfocused="OnTextUnfocused" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Нарушенное правило стоит над клавиатурой, а не в конце формы: внизу
             экрана оно видно всегда, и подводить к нему прокруткой не нужно -->
        <Border Grid.Row="1" Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}"
                Margin="16,0,16,8">
            <Label Padding="14,10" Text="{Binding Error}" Style="{StaticResource NegativeLabel}" />
        </Border>

        <controls:AmountKeypad Grid.Row="2" IsVisible="{Binding AreKeysVisible}"
                               KeyCommand="{Binding PressKeyCommand}"
                               BackspaceCommand="{Binding BackspaceCommand}"
                               EqualsCommand="{Binding EvaluateCommand}" />

    </Grid>

</pages:DataPage>
