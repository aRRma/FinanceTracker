<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экраны B-01, B-05, B-06: форма операции — запись и правка одной формой;
    C-01 — та же форма с нарушенным правилом; C-07 — удаление с подтверждением.
    Форма перестраивается по виду: у перевода второй счёт вместо категории и места,
    вторая сумма — только при разных валютах счетов. Клавиатура суммы прижата
    к низу и открыта сразу: сумму меняют всегда. Сохранение — на панели заголовка.

    Две карточки: в первой обязательное — вид, сумма, счёт и категория, во второй
    всё, что можно не заполнять, — дата, место и заметка. Три поля в ряд под суммой
    отвергнуты: длинные имена обрезались бы на трети ширины.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.TransactionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:card="clr-namespace:Finance.Application.Features.Transactions.Card;assembly=Finance.Application"
    xmlns:domain="clr-namespace:Finance.Domain.Enums;assembly=Finance.Domain"
    x:DataType="card:TransactionViewModel"
    Title="{Binding Title}"
    Shell.TabBarIsVisible="False">

    <!--
        Панель заголовка своя: сохранение — зелёная клавиша у правого края,
        удаление рядом подписью. Штатный ToolbarItem фона не имеет, а с клавиатуры
        сохранение ушло: она уходит с экрана целиком, пока набирают заметку,
        и уносила бы сохранение с собой.
    -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,10,0" HorizontalOptions="Fill">
            <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource BarTitleLabel}" />
            <Button Grid.Column="1" Text="{x:Static texts:UiTexts.CommonDelete}" Style="{StaticResource BarDangerButton}"
                    IsVisible="{Binding IsExisting}" AutomationId="DeleteTransaction" Clicked="OnDelete" />
            <Button Grid.Column="2" Text="{x:Static texts:UiTexts.CommonSave}" Style="{StaticResource BarSaveButton}"
                    IsEnabled="{Binding CanSave}" AutomationId="SaveTransaction" Clicked="OnSave" />
        </Grid>
    </Shell.TitleView>

    <!--
        Клавиатура прижата к низу, а в .NET 10 страница по умолчанию идёт от края
        до края: без этого нижний ряд клавиш уезжает под жестовую полосу, а при
        наборе заметки — под системную клавиатуру.
    -->
    <Grid RowDefinitions="*,Auto,Auto" SafeAreaEdges="Container, Container, Container, All">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,8" Spacing="12">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>

                        <!-- Вид операции. По умолчанию расход — он записывается чаще всего.
                             Сегменты во всю высоту шапки карточки, углы срезает сама карточка -->
                        <Grid ColumnDefinitions="*,*,*" HeightRequest="{StaticResource TouchTarget}"
                              RadioButtonGroup.GroupName="kind"
                              RadioButtonGroup.SelectedValue="{Binding Kind}">
                            <RadioButton Grid.Column="0" Content="{x:Static texts:UiTexts.KindExpense}" Value="{x:Static domain:TransactionKind.Expense}"
                                         ControlTemplate="{StaticResource ExpenseSegmentTemplate}" />
                            <RadioButton Grid.Column="1" Content="{x:Static texts:UiTexts.KindIncome}" Value="{x:Static domain:TransactionKind.Income}"
                                         ControlTemplate="{StaticResource IncomeSegmentTemplate}" />
                            <RadioButton Grid.Column="2" Content="{x:Static texts:UiTexts.KindTransfer}" Value="{x:Static domain:TransactionKind.Transfer}"
                                         ControlTemplate="{StaticResource TransferSegmentTemplate}" />
                        </Grid>

                        <BoxView Style="{StaticResource Divider}" />

                        <!--
                            Итог — главная цифра экрана, крупно и поровну отступив сверху
                            и снизу. Выражение появляется над ним, в верхнем отступе, только
                            когда набран знак действия: у простого числа оно повторяло бы итог.
                            Подписи «Сумма» нет — поле и так узнаётся, а вслух его называет
                            описание. Набираемое поле подсвечено, только когда полей два.
                        -->
                        <Grid RowDefinitions="30,Auto,30" Padding="16,0"
                              SemanticProperties.Description="{x:Static texts:UiTexts.TransactionAmount}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ActivateSourceAmountCommand}" />
                            </Grid.GestureRecognizers>
                            <Grid.Triggers>
                                <MultiTrigger TargetType="Grid">
                                    <MultiTrigger.Conditions>
                                        <BindingCondition Binding="{Binding NeedsTargetAmount}" Value="True" />
                                        <BindingCondition Binding="{Binding IsSourceAmountActive}" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
                                </MultiTrigger>
                            </Grid.Triggers>

                            <Label Grid.Row="0" Text="{Binding AmountDisplay}" Style="{StaticResource AmountExpression}"
                                   IsVisible="{Binding HasAmountOperation}" VerticalOptions="End" />
                            <!-- Подсказка про «=» — отдельной подписью, а не тем же полем
                                 мельче: главная цифра подбирает кегль по ширине и раздула бы её -->
                            <Label Grid.Row="1" Text="{Binding AmountHero}" Style="{StaticResource AmountPending}"
                                   IsVisible="{Binding HasAmountOperation}" />
                            <controls:FitLabel Grid.Row="1" Text="{Binding AmountHero}" Style="{StaticResource AmountHero}">
                                <controls:FitLabel.Triggers>
                                    <DataTrigger TargetType="controls:FitLabel" Binding="{Binding HasAmountOperation}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="controls:FitLabel" Binding="{Binding AmountTone}" Value="{x:Static card:AmountTone.Expense}">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="controls:FitLabel" Binding="{Binding AmountTone}" Value="{x:Static card:AmountTone.Income}">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="controls:FitLabel" Binding="{Binding AmountTone}" Value="{x:Static card:AmountTone.Placeholder}">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                    </DataTrigger>
                                </controls:FitLabel.Triggers>
                            </controls:FitLabel>
                        </Grid>

                        <!-- Сумма зачисления — у перевода между валютами. Подпись у неё
                             остаётся: без неё две суммы в одной карточке не различить -->
                        <VerticalStackLayout IsVisible="{Binding NeedsTargetAmount}">
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid RowDefinitions="30,Auto,30" Padding="16,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ActivateTargetAmountCommand}" />
                                </Grid.GestureRecognizers>
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsTargetAmountActive}" Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light={StaticResource SunkLight}, Dark={StaticResource SunkDark}}" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="End">
                                    <Label Grid.Column="0" Text="{x:Static texts:UiTexts.TransactionTargetAmount}" Style="{StaticResource CaptionLabel}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding TargetAmountDisplay}" Style="{StaticResource AmountExpression}"
                                           IsVisible="{Binding HasTargetAmountOperation}" HorizontalTextAlignment="End" />
                                </Grid>
                                <Label Grid.Row="1" Text="{Binding TargetAmountHero}" Style="{StaticResource AmountPending}"
                                       IsVisible="{Binding HasTargetAmountOperation}" />
                                <controls:FitLabel Grid.Row="1" Text="{Binding TargetAmountHero}" Style="{StaticResource AmountHero}">
                                    <controls:FitLabel.Triggers>
                                        <DataTrigger TargetType="controls:FitLabel" Binding="{Binding HasTargetAmountOperation}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="controls:FitLabel" Binding="{Binding TargetAmountTone}" Value="{x:Static card:AmountTone.Placeholder}">
                                            <Setter Property="TextColor"
                                                    Value="{AppThemeBinding Light={StaticResource Ink3Light}, Dark={StaticResource Ink3Dark}}" />
                                        </DataTrigger>
                                    </controls:FitLabel.Triggers>
                                </controls:FitLabel>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <!--
                            Счёт и категория — под суммой, пополам. Выбираются на своих
                            экранах: списков по полсотни строк, и системный выпадающий список
                            показал бы их сплошняком, без групп, значков и поиска. Значок
                            у счёта — его типа, у категории — самой подкатегории на плашке
                            цвета вида. У перевода справа вместо категории — счёт зачисления.
                        -->
                        <!--
                            Незаполненное обязательное поле — тихая метка: кольцо цветом
                            действия вокруг значка, точка у подписи и подпись тем же цветом.
                            Рамка и заливка отвергнуты: категория пуста на каждой новой
                            операции, и громкая подсветка встречала бы каждый раз. Чего
                            не хватает при сохранении, называет всплывающее сообщение.
                        -->
                        <Grid ColumnDefinitions="*,1,*">
                            <Grid Grid.Column="0" Padding="12,8" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                  MinimumHeightRequest="58">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickAccount" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource FieldBadge}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding HasSourceAccount}" Value="False">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <controls:Icon Key="{Binding SourceAccountIcon}" HorizontalOptions="Center">
                                        <controls:Icon.Triggers>
                                            <DataTrigger TargetType="controls:Icon" Binding="{Binding HasSourceAccount}" Value="False">
                                                <Setter Property="Stroke"
                                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            </DataTrigger>
                                        </controls:Icon.Triggers>
                                    </controls:Icon>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{Binding SourceLabel}" Style="{StaticResource CaptionLabel}" />
                                        <BoxView Style="{StaticResource RequiredDot}">
                                            <BoxView.Triggers>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding HasSourceAccount}" Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </BoxView.Triggers>
                                        </BoxView>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding SourceAccountCaption}" Style="{StaticResource FieldValue}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasSourceAccount}" Value="False">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView Grid.Column="1" WidthRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

                            <Grid Grid.Column="2" Padding="12,8" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                  MinimumHeightRequest="58" IsVisible="{Binding IsNotTransfer}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickCategory" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource FieldBadge}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding HasCategory}" Value="False">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                        <MultiTrigger TargetType="Border">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding HasCategory}" Value="True" />
                                                <BindingCondition Binding="{Binding Kind}" Value="{x:Static domain:TransactionKind.Expense}" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource NegativeBackgroundLight}, Dark={StaticResource NegativeBackgroundDark}}" />
                                        </MultiTrigger>
                                        <MultiTrigger TargetType="Border">
                                            <MultiTrigger.Conditions>
                                                <BindingCondition Binding="{Binding HasCategory}" Value="True" />
                                                <BindingCondition Binding="{Binding Kind}" Value="{x:Static domain:TransactionKind.Income}" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource PositiveBackgroundLight}, Dark={StaticResource PositiveBackgroundDark}}" />
                                        </MultiTrigger>
                                    </Border.Triggers>
                                    <controls:Icon Key="{Binding CategoryIcon}" HorizontalOptions="Center">
                                        <controls:Icon.Triggers>
                                            <DataTrigger TargetType="controls:Icon" Binding="{Binding HasCategory}" Value="False">
                                                <Setter Property="Stroke"
                                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            </DataTrigger>
                                            <MultiTrigger TargetType="controls:Icon">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding HasCategory}" Value="True" />
                                                    <BindingCondition Binding="{Binding Kind}" Value="{x:Static domain:TransactionKind.Expense}" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Stroke"
                                                        Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                            </MultiTrigger>
                                            <MultiTrigger TargetType="controls:Icon">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding HasCategory}" Value="True" />
                                                    <BindingCondition Binding="{Binding Kind}" Value="{x:Static domain:TransactionKind.Income}" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Stroke"
                                                        Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                            </MultiTrigger>
                                        </controls:Icon.Triggers>
                                    </controls:Icon>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static texts:UiTexts.TransactionCategory}" Style="{StaticResource CaptionLabel}" />
                                        <BoxView Style="{StaticResource RequiredDot}">
                                            <BoxView.Triggers>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding HasCategory}" Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </BoxView.Triggers>
                                        </BoxView>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding CategoryCaption}" Style="{StaticResource FieldValue}">
                                        <Label.Triggers>
                                            <!-- Невыбранная категория подписана цветом действия:
                                                 это приглашение, а не значение поля -->
                                            <DataTrigger TargetType="Label" Binding="{Binding HasCategory}" Value="False">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid Grid.Column="2" Padding="12,8" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                  MinimumHeightRequest="58" IsVisible="{Binding IsTransfer}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickTargetAccount" />
                                </Grid.GestureRecognizers>
                                <Border Grid.Column="0" Style="{StaticResource FieldBadge}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding HasTargetAccount}" Value="False">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
                                            <Setter Property="Stroke"
                                                    Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <controls:Icon Key="{Binding TargetAccountIcon}" HorizontalOptions="Center">
                                        <controls:Icon.Triggers>
                                            <DataTrigger TargetType="controls:Icon" Binding="{Binding HasTargetAccount}" Value="False">
                                                <Setter Property="Stroke"
                                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            </DataTrigger>
                                        </controls:Icon.Triggers>
                                    </controls:Icon>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static texts:UiTexts.TransactionTarget}" Style="{StaticResource CaptionLabel}" />
                                        <BoxView Style="{StaticResource RequiredDot}">
                                            <BoxView.Triggers>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding HasTargetAccount}" Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </BoxView.Triggers>
                                        </BoxView>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding TargetAccountCaption}" Style="{StaticResource FieldValue}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding HasTargetAccount}" Value="False">
                                                <Setter Property="TextColor"
                                                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <!--
                            Дата — строкой в ряд с остальными полями: подпись, чипы
                            «Сегодня» и «Вчера», третий чип открывает календарь.
                            Системный календарь с подчёркиванием в форме не показывается:
                            он чужой для остального оформления, а «Сегодня / Вчера»
                            под ним уезжали под клавиатуру.
                            При крупном шрифте системы дате и чипам не хватает одной строки:
                            тогда на вторую строку уходят чипы целиком, а дата остаётся
                            целой. Ужать её не выходило — даже мельчайшим кеглем
                            «24 сентября» обрезалась до «24 сен», а прежде ломалась пополам.
                        -->
                        <Grid Padding="14,8" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                              MinimumHeightRequest="{StaticResource TouchTarget}">
                            <controls:Icon Grid.Column="0" Key="calendar" Style="{StaticResource MutedIcon}" />
                            <FlexLayout Grid.Column="1" Wrap="Wrap" JustifyContent="SpaceBetween"
                                        AlignItems="Center" AlignContent="Center">
                                <Label Text="{Binding OccurredOnCaption}" MaxLines="1" Margin="0,0,12,0" VerticalOptions="Center" />
                                <HorizontalStackLayout Spacing="6">
                                    <Border Style="{StaticResource Chip}" AutomationId="DateToday">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Style" Value="{StaticResource ChipSelected}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetTodayCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{x:Static texts:UiTexts.TransactionToday}" Style="{StaticResource ChipLabel}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource ChipSelectedLabel}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" AutomationId="DateYesterday">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsYesterday}" Value="True">
                                                <Setter Property="Style" Value="{StaticResource ChipSelected}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SetYesterdayCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{x:Static texts:UiTexts.TransactionYesterday}" Style="{StaticResource ChipLabel}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsYesterday}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource ChipSelectedLabel}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                    <Border Style="{StaticResource Chip}" AutomationId="DateOther"
                                            SemanticProperties.Description="{x:Static texts:UiTexts.TransactionCalendarHint}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPickDate" />
                                        </Border.GestureRecognizers>
                                        <Label Text="…" Style="{StaticResource ChipLabel}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </Grid>

                        <!-- Календарь живёт на экране невидимым: открыть системный диалог
                             можно только через сам контрол, и убрать его из дерева нельзя.
                             Будущие дни и дни раньше открытия счёта он не предлагает -->
                        <DatePicker x:Name="Calendar" Date="{Binding OccurredOnDate}"
                                    MinimumDate="{Binding EarliestDate}"
                                    MaximumDate="{Binding LatestDate}"
                                    Opacity="0" HeightRequest="1" MinimumHeightRequest="1" InputTransparent="True" />

                        <!-- Место необязательно, поэтому стоит здесь, рядом с датой и
                             заметкой, а не под суммой со счётом и категорией -->
                        <VerticalStackLayout IsVisible="{Binding IsNotTransfer}">
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid Padding="14,0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12"
                                  MinimumHeightRequest="{StaticResource TouchTarget}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickPlace" />
                                </Grid.GestureRecognizers>

                                <controls:Icon Grid.Column="0" Key="map-pin" Style="{StaticResource MutedIcon}" />
                                <Label Grid.Column="1" Text="{x:Static texts:UiTexts.TransactionPlace}" VerticalOptions="Center"
                                       Style="{StaticResource SecondaryLabel}" />
                                <Label Grid.Column="2" Text="{Binding PlaceCaption}" VerticalOptions="Center"
                                       HorizontalTextAlignment="End" LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HasPlace}" Value="False">
                                            <Setter Property="Style" Value="{StaticResource CaptionLabel}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <controls:Icon Grid.Column="3" Key="chevron-right" Style="{StaticResource MutedIcon}" />
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Padding="14,0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <controls:Icon Grid.Column="0" Key="pencil" Style="{StaticResource MutedIcon}" />
                            <Entry Grid.Column="1" Text="{Binding Note}" Placeholder="{x:Static texts:UiTexts.TransactionNotePlaceholder}"
                                   Focused="OnTextFocused" Unfocused="OnTextUnfocused" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Нарушенное правило стоит над клавиатурой, а не в конце формы: внизу
             экрана оно видно всегда, и подводить к нему прокруткой не нужно -->
        <Border Grid.Row="1" Style="{StaticResource ErrorCard}" IsVisible="{Binding HasError}"
                Margin="16,0,16,8">
            <Label Padding="14,10" Text="{Binding Error}" Style="{StaticResource NegativeLabel}" />
        </Border>

        <controls:AmountKeypad Grid.Row="2" IsVisible="{Binding AreKeysVisible}"
                               KeyCommand="{Binding PressKeyCommand}"
                               BackspaceCommand="{Binding BackspaceCommand}"
                               EqualsCommand="{Binding EvaluateCommand}" />

    </Grid>

</pages:DataPage>
