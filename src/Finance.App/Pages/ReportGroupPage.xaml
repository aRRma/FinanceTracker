<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Экран E-02: подкатегории группы за месяц. Доли пересчитаны внутри группы,
    а не от общего расхода: иначе все числа были бы мелкими и несравнимыми.
-->
<pages:DataPage
    x:Class="Finance.App.Pages.ReportGroupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    xmlns:controls="clr-namespace:Finance.App.Controls"
    xmlns:report="clr-namespace:Finance.Application.Features.Report;assembly=Finance.Application"
    x:DataType="report:ReportGroupViewModel"
    Title="{Binding Name}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Label Grid.Row="0" Padding="16,12,16,0" Text="{Binding Caption}"
               Style="{StaticResource SecondaryLabel}" />

        <Label Grid.Row="1" Padding="16,4,16,8" Text="{Binding Total}" HorizontalTextAlignment="End"
               IsVisible="{Binding HasItems}" Style="{StaticResource TotalLabel}">
            <Label.Triggers>
                <!-- Цвет, а не стиль: у итога свой шрифт, и подмена стиля его потеряла бы -->
                <DataTrigger TargetType="Label" Binding="{Binding IsTotalExpense}" Value="True">
                    <Setter Property="TextColor"
                            Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsTotalExpense}" Value="False">
                    <Setter Property="TextColor"
                            Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="report:ReportRowItem">
                    <Grid Padding="16,10,16,6" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12"
                          RowDefinitions="Auto,Auto" RowSpacing="6"
                          MinimumHeightRequest="{StaticResource TouchTarget}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRowTapped" />
                        </Grid.GestureRecognizers>

                        <controls:Icon Grid.Column="0" Grid.Row="0" Key="{Binding Icon}" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{Binding Name}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Grid.Row="0" Text="{Binding Amount}" VerticalOptions="Center"
                               Style="{StaticResource AmountLabel}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                                    <Setter Property="Style" Value="{StaticResource AmountNegativeLabel}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="False">
                                    <Setter Property="Style" Value="{StaticResource AmountPositiveLabel}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Grid.Column="3" Grid.Row="0" Text="{Binding Share}" VerticalOptions="Center"
                               MinimumWidthRequest="40" HorizontalTextAlignment="End"
                               Style="{StaticResource SecondaryLabel}" />
                        <ProgressBar Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3"
                                     Progress="{Binding Fraction}" HeightRequest="4"
                                     ProgressColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Пустое состояние — внутри списка: соседом в той же ячейке оно оказалось бы
                 под ним, и пустой список перехватывал бы касания поверх текста -->
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="32" Spacing="12"
                                         VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="{x:Static texts:UiTexts.ReportGroupEmptyTitle}" HorizontalTextAlignment="Center"
                               Style="{StaticResource TitleLabel}" />
                        <Label Text="{x:Static texts:UiTexts.ReportGroupEmptyHint}"
                               HorizontalTextAlignment="Center" Style="{StaticResource SecondaryLabel}" />
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</pages:DataPage>
