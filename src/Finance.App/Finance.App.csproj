<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Единственная платформа: iOS, Windows и Mac Catalyst вне MVP (SYS-01) -->
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>Finance.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Личный трекер финансов</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>ru.finance.tracker</ApplicationId>

		<!-- Версия. Здесь лежит значение для сборок с рабочей машины; релиз
		     получает своё из тега и передаёт его в командной строке
		     (-p:ApplicationDisplayVersion=...). Заданное так свойство у MSBuild
		     глобальное и значение отсюда перекрывает: расхождение этого числа
		     с номером релиза — не ошибка.

		     ApplicationVersion — versionCode Android, целое и только растущее:
		     на меньшее платформа обновление не ставит. Считается из версии как
		     major*10000 + minor*100 + patch, поэтому руками не правится. -->
		<ApplicationDisplayVersion>1.0.4</ApplicationDisplayVersion>
		<ApplicationVersion>10004</ApplicationVersion>

		<!-- Android 16 (API 36): приложение личное, охват старых версий не требуется (SYS-01) -->
		<SupportedOSPlatformVersion>36.0</SupportedOSPlatformVersion>

		<!-- Полный AOT вместо профильного. Релиз по умолчанию заранее компилирует
		     только то, что попало в стартовый профиль шаблонного приложения MAUI,
		     а EF Core и наш код при запуске компилирует JIT. Замер на эмуляторе
		     (сентябрь 2026, медиана десяти холодных стартов): 4,2 → 2,1 с до
		     первого кадра с данными, цена — APK 40,7 → 62,1 МБ. Действует только
		     в Release: Debug идёт без AOT.

		     NativeAOT в MAUI 10 официально только для iOS и
		     Mac Catalyst, на Android — экспериментальный; EF Core под ним требует
		     предкомпилированную модель, а её не даёт фильтр мягкого удаления -->
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F5C4C" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F5C4C" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Контуры значков: ключи набора лежат в Finance.Application, а рисует их только приложение -->
		<EmbeddedResource Include="..\..\data\icon-paths.json" LogicalName="Finance.App.icon-paths.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Finance.Domain\Finance.Domain.csproj" />
	  <ProjectReference Include="..\Finance.Application\Finance.Application.csproj" />
	</ItemGroup>

</Project>
