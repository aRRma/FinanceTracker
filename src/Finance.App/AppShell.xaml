<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Четыре вкладки каркаса (экраны A-01…A-04). Пятой не будет: всё остальное —
    справочники и настройки — живёт за вкладкой «Ещё».

    Значки вкладок — картинками, а не контролом Icon: вкладке Shell нужен
    ImageSource. Контуры те же, что в макете; цвет даёт Shell.TabBar*Color,
    поэтому в самих файлах он не важен.
-->
<Shell
    x:Class="Finance.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:texts="clr-namespace:Finance.Application.Texts;assembly=Finance.Application"
    xmlns:pages="clr-namespace:Finance.App.Pages"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="{x:Static texts:UiTexts.BalancesTitle}"
            ContentTemplate="{DataTemplate pages:BalancesPage}"
            Icon="tab_balances.png"
            Route="balances" />

        <ShellContent
            Title="{x:Static texts:UiTexts.FeedTitle}"
            ContentTemplate="{DataTemplate pages:FeedPage}"
            Icon="tab_feed.png"
            Route="feed" />

        <ShellContent
            Title="{x:Static texts:UiTexts.ReportTitle}"
            ContentTemplate="{DataTemplate pages:ReportPage}"
            Icon="tab_report.png"
            Route="report" />

        <ShellContent
            Title="{x:Static texts:UiTexts.MoreTitle}"
            ContentTemplate="{DataTemplate pages:MorePage}"
            Icon="tab_more.png"
            Route="more" />
    </TabBar>

</Shell>
